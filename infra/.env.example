# Copia este archivo a `infra/.env` (que NUNCA se commitea) si quieres cambiar
# los valores por defecto del Postgres local. Sin `.env`, el compose usa estos
# mismos valores como defaults.
#
# Estas credenciales son de un Postgres de desarrollo en tu máquina. Las de
# producción viven en el VPS y no entran al repo jamás.
#
# EN EL VPS, BORRA ESTAS CUATRO LÍNEAS: con `POSTGRES_PASSWORD=monitor` aquí, la guardia
# del compose de producción no truena y la base nace con la contraseña de desarrollo.

POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor
POSTGRES_PORT=5432

# =============================================================================
# PRODUCCIÓN (F1-002) — sólo en el `infra/.env` del VPS. Guía: docs/produccion.md
# =============================================================================
# En el VPS este archivo se copia a `infra/.env`, se BORRA el bloque de desarrollo
# de arriba y se descomenta lo de abajo. El
# mismo archivo alimenta dos cosas: la interpolación del compose (dominio, Postgres)
# y, por `env_file`, el entorno de la API. NODE_ENV, PORT, TRUST_PROXY_SALTOS,
# DATABASE_URL, ARCHIVOS_RAIZ, PANEL_URL y ARCHIVOS_URL_BASE los fija
# `docker-compose.prod.yml` y no se ponen aquí.
#
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# --- Compose ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# `:` es el separador en Linux; se fija para que lo mismo sirva al probar en Windows.
# COMPOSE_PATH_SEPARATOR=:
# Dominio raíz, sin subdominio ni https. Caddy sirve DOMINIO, www., app. y api.
# DOMINIO=tu-dominio.mx
# Correo al que Let's Encrypt avisa de certificados por vencer.
# ACME_EMAIL=
#
# --- Postgres (reemplaza los de desarrollo de arriba) ---
# Contraseña SOLO con letras, números, - y _ (va dentro de la URL de conexión):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# POSTGRES_PASSWORD=
#
# --- API: obligatorias con NODE_ENV=production (sin ellas, no arranca) ---
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# Los cuatro puertos externos tienen que ser REALES (adaptadores/config.ts): con
# uno en `falso`, la API no arranca. Ver en docs/produccion.md qué cuenta pide cada uno.
# PAC_IMPL=facturama
# FACTURAMA_USUARIO=
# FACTURAMA_PASSWORD=
# Sin FACTURAMA_URL se timbra contra el SANDBOX. El productivo se pone a mano (F2-190):
# FACTURAMA_URL=https://api.facturama.mx
# CORREO_IMPL=brevo
# BREVO_API_KEY=
# CORREO_REMITENTE=
# CORREO_REMITENTE_NOMBRE=Monitor SoftRestaurant
# ARCHIVOS_IMPL=disco
# ARCHIVOS_SECRETO=
# PUSH_IMPL=webpush
# Una sola vez y nunca se rotan (`npx web-push generate-vapid-keys` en /api):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@tu-dominio.mx
#
# --- API: opcionales ---
# Buzón del formulario de contacto de la landing. Sin él, en producción responde 503.
# CONTACTO_DESTINO=
# Zip https del instalador del agente (el asistente de alta lo enlaza).
# AGENTE_URL_DESCARGA=
# Swagger en /docs con HTTP Basic. Sin las dos, /docs no se monta.
# DOCS_USUARIO=
# DOCS_PASSWORD=
