# ---------- Secretos y configuración local ----------
# Nunca al repo: cadenas de conexión al SQL Server del cliente, API keys de
# sucursal, credenciales del PAC, claves del CSD.
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
config.json
!infra/config.example.json
*.pem
*.key
*.cer
*.pfx
secrets/
.ssh/

# ---------- Prisma ----------
# Las migraciones SÍ se versionan. Lo que no: el shadow db y los artefactos.
/api/prisma/*.db
/api/prisma/*.db-journal

# ---------- Infra ----------
infra/caddy_data/
infra/caddy_config/
infra/pgdata/
infra/backups/

# ---------- Claude Code ----------
# Se versiona la config de proyecto (settings.json, hooks, agents), NO lo
# personal/local.
.claude/settings.local.json
.claude/prompts/
**/.claude/settings.local.json

# Salida del runner nocturno: log de corrida, no se versiona. El patrón cubre
# `docs/nocturno-AAAAMMDD-HHMM.txt`, que es como los nombra
# `scripts/nocturno-v2.ps1`: sin él, un `git add -A` en el commit que marca `[x]`
# se lleva la salida de la corrida a main.
docs/nocturno-20*.txt

# Centinelas del orquestador nocturno. Los crea la sesión como último acto para
# decirle al vigilante cómo terminó, y `scripts/nocturno-v2.ps1` los borra al
# empezar cada vuelta. Son señales entre dos procesos de esta máquina, no
# historia del repo — y si se colaran a main, la sesión siguiente arrancaría con
# un centinela puesto y moriría en el primer minuto sin hacer nada.
TAREA_CERRADA.txt
TAREA_SALTADA.txt
COLA_VACIA.txt

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Sistema nocturno local (no compartir) ----------
# El orquestador del modo autónomo y su protocolo viven sólo en la máquina de
# Ricardo. Rutas exactas a propósito: ningún patrón aquí puede alcanzar a
# backlog.md, docs/nocturno-log.md ni scripts/git-hooks/pre-push, que el loop
# necesita versionados.
/scripts/nocturno-v2.ps1
/MODO-AUTONOMO.local.md
