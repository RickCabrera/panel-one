{
  "name": "monitor-softrestaurant",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo del monitor para SoftRestaurant: agente Windows, API NestJS y panel React.",
  "license": "UNLICENSED",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @monitor/api",
    "dev:web": "npm run dev --workspace @monitor/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
