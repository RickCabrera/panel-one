# Copia a `api/.env` (nunca se commitea) para desarrollo local. Prisma lo carga solo.
#
# El Postgres de esta cadena es el de `infra/docker-compose.yml` (o un Postgres
# nativo en el 5432 con las mismas credenciales, ver README). El esquema llega
# con `npx prisma migrate dev` desde /api.
#
# NUNCA pongas aquí una cadena real de un cliente, ni la del SQL Server de
# SoftRestaurant: ésa vive en la máquina del restaurante, en la config del agente.

DATABASE_URL=postgresql://monitor:monitor@localhost:5432/monitor?schema=public
PORT=3000

# Secretos para firmar los JWT (F1-011). Obligatorios: la API no arranca sin
# ellos. Al menos 32 caracteres y DISTINTOS entre sí (con el mismo, un refresh
# valdría como access). Genera los tuyos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Los de abajo son de relleno y sólo sirven en local.
JWT_ACCESS_SECRET=relleno-local-access-cambia-esto-000000000000
JWT_REFRESH_SECRET=relleno-local-refresh-cambia-esto-00000000000

# Contraseña del admin global que crea `npx prisma db seed`. Sólo se usa al CREAR
# el usuario (volver a correr el seed no la cambia). Si falta, el seed usa este
# mismo valor de desarrollo y lo avisa en consola. El seed se niega a correr con
# NODE_ENV=production.
SEED_ADMIN_PASSWORD=cambiar-en-local

# `/docs` (Swagger UI del contrato, F1-033) protegido con HTTP Basic. Si NO
# defines ninguna de las dos, `/docs` no se monta (404). Si defines sólo una, o
# una contraseña de menos de 16 caracteres, la API no arranca. Relleno local:
DOCS_USUARIO=docs
DOCS_PASSWORD=relleno-local-docs-cambia-esto

# Cuántos proxies delante de la API se creen el `X-Forwarded-For` (F1-092). De ahí
# sale la IP de los rate limits (login 5/min, refresh 30/min). Local, sin proxy:
# 0 (o sin poner). Producción detrás de Caddy (F1-002): 1, y NO es opcional. Sin el 1,
# TODOS los usuarios comparten la IP de Caddy: el login admite 5 intentos/min para
# todos y el refresh silencioso (30/min) se agota en hora pico y los saca al login.
# Con proxy NO pongas más saltos de los que hay: el cliente podría inventarse la IP.
TRUST_PROXY_SALTOS=0

# Servicios externos (F2-202). Cada uno se elige por variable; sin ella, `falso`.
# Con NODE_ENV=production la API NO ARRANCA si alguno queda en `falso` (el mensaje
# nombra la variable). Las credenciales de una real sólo se piden si la eliges; aquí
# van vacías a propósito: nunca pongas una real en este archivo.
#
# PAC (timbrado de CFDI): falso | facturama
PAC_IMPL=falso
# Con PAC_IMPL=facturama (F2-190). FACTURAMA_URL por defecto: el sandbox.
# FACTURAMA_URL=https://apisandbox.facturama.mx
# FACTURAMA_USUARIO=
# FACTURAMA_PASSWORD=
#
# Correo saliente: falso | brevo. El falso escribe en CORREO_DIR_FALSO (por defecto
# <temporal del sistema>/correos) y en la tabla `correos_enviados`.
CORREO_IMPL=falso
# CORREO_DIR_FALSO=
# Con CORREO_IMPL=brevo (F2-191):
# BREVO_API_KEY=
# CORREO_REMITENTE=
# CORREO_REMITENTE_NOMBRE=Monitor SoftRestaurant
#
# Archivos (XML y PDF de facturas): falso | disco. El falso guarda en
# ARCHIVOS_RAIZ_FALSO (por defecto <temporal del sistema>/monitor-archivos).
ARCHIVOS_IMPL=falso
# ARCHIVOS_RAIZ_FALSO=
# Con ARCHIVOS_IMPL=disco (el volumen persistente del servidor, F2-191): ruta
# ABSOLUTA, secreto de 32+ caracteres para firmar las URLs de descarga, y la URL base.
# ARCHIVOS_RAIZ=
# ARCHIVOS_SECRETO=
# ARCHIVOS_URL_BASE=

# Notificaciones push de la PWA (F2-146). falso = no sale nada a la red: los envíos quedan en
# memoria y, si se pone PUSH_DIR_FALSO (o con MODO_DEMO=1), en <dir>/<día>.jsonl.
# webpush = push real (FCM, Mozilla, WNS, Apple) firmado con VAPID; exige las tres VAPID_*.
# Con falso, las VAPID_* son opcionales: si están, el navegador local se puede suscribir (para
# probar la UI y el service worker). Generarlas UNA vez (no se rotan: rotarlas invalida todas
# las suscripciones): `npx web-push generate-vapid-keys` en /api. NUNCA al repo.
PUSH_IMPL=falso
# PUSH_DIR_FALSO=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@tu-dominio.mx
# Hosts EXTRA de servicios de push (coma; ".dominio" acepta subdominios). Sólo si un navegador
# usa uno que no esté en la lista de api/src/adaptadores/push/endpoint.ts.
# PUSH_HOSTS_PERMITIDOS=

# Modo demo (F2-202): 1 = la interfaz marca TODO como "Datos de ejemplo" (banda fija
# en todas las vistas y en el título de la pestaña). Para enseñar el producto sin POS.
MODO_DEMO=0

# Centro de alertas (F2-224): cada cuántos segundos se evalúan las alertas de todas las
# empresas (abre y cierra solas). 0 = apagado. Por defecto 60; en los tests va apagado.
# ALERTAS_INTERVALO_S=60

# Reportes programados por correo (F2-141). El programador revisa cada
# REPORTES_INTERVALO_S segundos (0 = apagado; por defecto 60; en los tests, apagado) y
# manda el resumen diario a las 07:00 de la zona de cada empresa (y el semanal los lunes)
# por el puerto de correo (CORREO_IMPL).
# REPORTES_INTERVALO_S=60
# Base de los enlaces del correo (al panel y a la baja). OBLIGATORIA y https con
# NODE_ENV=production: sin ella la API no arranca. Fuera de producción, el Vite local.
# PANEL_URL=http://localhost:5173

# Factura global (F2-108). El programador revisa cada GLOBAL_INTERVALO_S segundos (0 = apagado;
# por defecto 3600; en los tests, apagado) y emite la global de las empresas que la tienen
# AUTOMÁTICA (Facturación → Factura global; apagada por omisión).
# GLOBAL_INTERVALO_S=3600

# Control de folios del PAC (F2-110). El programador revisa cada FOLIOS_INTERVALO_S segundos (0 =
# apagado; por defecto 3600; en los tests, apagado) si el saldo cruzó el umbral o si un paquete vence
# en 30 días, y avisa por correo a los admin_global activos.
# FOLIOS_INTERVALO_S=3600

# Conciliación con el PAC (F2-110b). Cada CONCILIACION_INTERVALO_S segundos (0 = apagado; por
# defecto 900; en los tests, apagado) se resuelven contra el PAC las reservas colgadas en
# `timbrando`, las cancelaciones sin confirmar, las refacturaciones con la 01 pendiente y los CFDI
# vigentes sin archivos. También se dispara a mano desde el tablero de facturación.
# CONCILIACION_INTERVALO_S=900

# Resumen de cierre del día por push (F2-146). Cada NOTIFICACIONES_INTERVALO_S segundos (0 =
# apagado; por defecto 300; en los tests, apagado) se manda la venta de ayer a las 07:00 de la
# zona de cada empresa a quien lo tenga prendido. Las alertas por push no dependen de esto: salen
# cuando el centro de alertas las abre.
# NOTIFICACIONES_INTERVALO_S=300

# Onboarding y landing (F2-147).
# Buzón al que llega el formulario de contacto de la landing (sale por el correo de arriba:
# Brevo en producción). Sin ella: fuera de producción, `contacto@monitor.local` (el correo
# falso lo deja en su bandeja); EN producción el formulario responde 503. La real es de F2-191.
# CONTACTO_DESTINO=
# URL https del instalador del agente (el asistente de alta y el checklist la enlazan). Sin
# ella, el panel dice que el instalador lo entrega soporte. F2-143 la cambiará por una firmada.
# AGENTE_URL_DESCARGA=
