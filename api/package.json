{
  "name": "@monitor/api",
  "version": "0.0.1",
  "private": true,
  "description": "API del monitor: ingesta del agente y lectura para el panel.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "openapi": "ts-node src/openapi/generar.ts",
    "seed:ventas": "ts-node prisma/seed-ventas.ts",
    "seed:mesas": "ts-node prisma/seed-mesas.ts",
    "seed:alertas": "ts-node prisma/seed-alertas.ts",
    "seed:reportes": "ts-node prisma/seed-reportes.ts",
    "postinstall": "prisma generate",
    "setup:env": "ts-node scripts/setup-env.ts",
    "seed": "prisma db seed && npm run seed:ventas && npm run seed:mesas && npm run seed:alertas && npm run seed:reportes"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
