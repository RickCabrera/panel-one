{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionDto"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas. Misma respuesta para email inexistente, contraseña mala, usuario inactivo o empresa inactiva.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Más de 5 intentos por minuto desde la misma IP."
          }
        },
        "summary": "Inicia sesión. Pone la cookie `monitor_refresh` (httpOnly, SameSite=Strict, Path=/auth, 7 días; Secure en producción) con el refresh token.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin cookie, cookie inválida o vencida, o usuario/empresa ya inactivos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "monitor_refresh": []
          }
        ],
        "summary": "Emite un access token nuevo a partir de la cookie de refresh y la rota. Pone la cookie `monitor_refresh` (httpOnly, SameSite=Strict, Path=/auth, 7 días; Secure en producción) con el refresh token.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioActualDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin token, token inválido o vencido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "El usuario autenticado, leído de la base.",
        "tags": [
          "auth"
        ]
      }
    },
    "/sucursales/{id}/api-key": {
      "post": {
        "description": "La key se devuelve UNA sola vez; en la base queda su hash. Rotar invalida la key anterior de inmediato: el siguiente request del agente con ella es 401. Si llegan dos rotaciones a la vez, las dos responden 201 pero sólo la última key queda vigente.",
        "operationId": "SucursalApiKeyController_rotar",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyEmitidaDto"
                }
              }
            }
          },
          "400": {
            "description": "`id` no es un UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin token, token inválido o vencido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Rol insuficiente (visor).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "La sucursal no existe o es de otra empresa. Misma respuesta en los dos casos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Genera la API key del agente de la sucursal, o la rota si ya tenía una.",
        "tags": [
          "agentes"
        ]
      }
    },
    "/agente/yo": {
      "get": {
        "operationId": "AgenteController_yo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgenteYoDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin `X-Api-Key`, key desconocida o rotada, o sucursal/empresa inactiva. Mismo cuerpo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Más de 120 requests por minuto de la misma sucursal."
          }
        },
        "security": [
          {
            "agente": []
          }
        ],
        "summary": "La sucursal a la que pertenece la API key. Sirve al agente para verificar su key.",
        "tags": [
          "agente"
        ]
      }
    }
  },
  "info": {
    "title": "Monitor SoftRestaurant API",
    "description": "Contrato de la API del monitor. Fuente única: el frontend construye contra este documento. Lo genera `npm run openapi` en /api a partir de los decoradores.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "monitor_refresh"
      },
      "agente": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@monitor.local",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RolUsuario": {
        "type": "string",
        "enum": [
          "admin_global",
          "admin_empresa",
          "visor"
        ]
      },
      "UsuarioActualDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "admin@monitor.local"
          },
          "nombre": {
            "type": "string"
          },
          "rol": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RolUsuario"
              }
            ]
          },
          "empresaId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Nulo sólo para admin_global."
          }
        },
        "required": [
          "id",
          "email",
          "nombre",
          "rol",
          "empresaId"
        ]
      },
      "SesionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access token JWT. Va en `Authorization: Bearer <token>`."
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Vida del access token, en segundos."
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioActualDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "usuario"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Credenciales inválidas"
          },
          "error": {
            "type": "string",
            "example": "Unauthorized"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "ApiKeyEmitidaDto": {
        "type": "object",
        "properties": {
          "sucursalId": {
            "type": "string",
            "format": "uuid"
          },
          "apiKey": {
            "type": "string",
            "example": "msr_3q2-7wXz...",
            "description": "La API key en claro. Se muestra SÓLO en esta respuesta: en la base queda su hash. El agente la manda en el header `X-Api-Key`."
          }
        },
        "required": [
          "sucursalId",
          "apiKey"
        ]
      },
      "AgenteYoDto": {
        "type": "object",
        "properties": {
          "sucursalId": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "zonaHoraria": {
            "type": "string",
            "example": "America/Mexico_City",
            "description": "Zona IANA de la sucursal."
          }
        },
        "required": [
          "sucursalId",
          "nombre",
          "zonaHoraria"
        ]
      }
    }
  }
}
