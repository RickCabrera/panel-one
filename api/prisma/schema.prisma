model Insumo {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  // DECISION PROVISIONAL (nocturno): un insumo tiene UN grupo y UNA unidad, por su
