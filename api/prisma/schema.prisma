// F2-121. Existencia ACTUAL de un insumo en un almacén de la sucursal: la última foto que el
// agente mandó de ese almacén (`POST /ingesta/existencias`). Es estado, no catálogo: lo que
// sale de la foto se BORRA (la historia es de los movimientos, F2-122). Almacén e insumo por
// su `origen_sr_id` en TEXTO y sin FK (el orden de llegada de los catálogos no está
// garantizado, como el grupo del insumo). esquema-sr.md §10.
// Cantidad NUMERIC(12,3) (puede ser negativa: SR podría permitirlo); costo promedio y valor
// son dinero NUMERIC(12,2); `valor` = round(cantidad × costo, 2) lo calcula el API.
model Existencia {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  sucursalId        String   @map("sucursal_id") @db.Uuid
  almacenOrigenSrId String   @map("almacen_origen_sr_id")
  insumoOrigenSrId  String   @map("insumo_origen_sr_id")
  cantidad          Decimal  @db.Decimal(12, 3)
  costoPromedio     Decimal  @map("costo_promedio") @db.Decimal(12, 2)
  valor             Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "existencias_sucursal_empresa_fkey")

  @@unique([sucursalId, almacenOrigenSrId, insumoOrigenSrId], map: "existencias_sucursal_almacen_insumo_key")
  @@index([empresaId])
  @@map("existencias")
}

// F2-121. La última foto APLICADA de cada almacén: su `capturado_at` (reloj del agente)
// decide qué foto es obsoleta; `recibida_at` (reloj del API) dice si la lectura va atrasada.
model LecturaExistencias {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  sucursalId        String   @map("sucursal_id") @db.Uuid
  almacenOrigenSrId String   @map("almacen_origen_sr_id")
  capturadoAt       DateTime @map("capturado_at") @db.Timestamptz(3)
  recibidaAt        DateTime @map("recibida_at") @db.Timestamptz(3)
  filas             Int

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "lecturas_existencias_sucursal_empresa_fkey")

  @@unique([sucursalId, almacenOrigenSrId], map: "lecturas_existencias_sucursal_almacen_key")
  @@index([empresaId])
  @@map("lecturas_existencias")
}

// F2-121. Mínimo y máximo de un insumo en un almacén: son NUESTROS (se editan en el panel y
// NUNCA se escriben a SR). Viven aparte: la ingesta no los toca y sobreviven a que el artículo
// salga de la foto. CHECKs a mano: >= 0, mínimo <= máximo, al menos uno no nulo.
model LimiteExistencia {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  sucursalId        String   @map("sucursal_id") @db.Uuid
  almacenOrigenSrId String   @map("almacen_origen_sr_id")
  insumoOrigenSrId  String   @map("insumo_origen_sr_id")
  // No es dinero: existencias (unidades, kg) como `cantidad`.
  minimo            Decimal? @db.Decimal(12, 3)
  maximo            Decimal? @db.Decimal(12, 3)
  actualizadoPor    String   @map("actualizado_por") @db.Uuid
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "limites_existencia_sucursal_empresa_fkey")

  @@unique([sucursalId, almacenOrigenSrId, insumoOrigenSrId], map: "limites_existencia_sucursal_almacen_insumo_key")
  @@index([empresaId])
  @@map("limites_existencia")
}

// F2-122. Tipo de una póliza de inventario, NUESTRO: SR no está mapeado (esquema-sr §10). El
// lector (F2-241) traduce el tipo de SR a éste y manda además el código crudo (`tipo_sr`); lo
// que no sepa traducir llega como `otro`.
enum TipoPolizaInventario {
  inicial
  compra
  consumo
  merma
  traspaso_salida
  traspaso_entrada
  ajuste
  otro

  @@map("tipo_poliza_inventario")
}

// F2-122. Una póliza (documento) de inventario leída de SR: la cabecera. La escribe SÓLO
// `IngestaMovimientos` (clavada a la sucursal del agente), upsert por (sucursal, origen_sr_id).
// `hash` = sha256 de su forma canónica (cabecera + partidas): igual = no se toca. `leida_at`
// (reloj del agente) decide qué versión es más nueva: una más vieja no escribe nada.
// DECISION PROVISIONAL (nocturno): un almacén por póliza (un traspaso son dos pólizas), y una
// póliza que desaparece de SR no se borra: el lector la manda `cancelada`. esquema-sr §10.
model PolizaInventario {
  id                String               @id @default(uuid()) @db.Uuid
  empresaId         String               @map("empresa_id") @db.Uuid
  sucursalId        String               @map("sucursal_id") @db.Uuid
  origenSrId        String               @map("origen_sr_id")
  folio             String
  tipo              TipoPolizaInventario
  tipoSr            String?              @map("tipo_sr")
  almacenOrigenSrId String               @map("almacen_origen_sr_id")
  fecha             DateTime             @db.Timestamptz(3)
  referencia        String?
  cancelada         Boolean
  partidas          Int
  hash              String
  leidaAt           DateTime             @map("leida_at") @db.Timestamptz(3)
  recibidaAt        DateTime             @map("recibida_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @map("updated_at") @db.Timestamptz(3)

  sucursal         Sucursal               @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "polizas_inventario_sucursal_empresa_fkey")
  movimientos      MovimientoInventario[]
  // F2-124: renglones de traspasos del panel conciliados contra esta póliza.
  traspasosSalida  PartidaTraspaso[]      @relation("EspejoSalida")
  traspasosEntrada PartidaTraspaso[]      @relation("EspejoEntrada")

  @@unique([sucursalId, origenSrId], map: "polizas_inventario_sucursal_origen_key")
  @@unique([id, sucursalId, empresaId], map: "polizas_inventario_id_sucursal_empresa_key")
  @@index([empresaId])
  @@index([sucursalId, fecha])
  @@map("polizas_inventario")
}

// F2-122. Una partida (renglón) de una póliza: el movimiento de UN insumo. `cantidad` CON SIGNO
// (+ entra, − sale); `importe` = round(cantidad × costo_unitario, 2) lo calcula el API. El
// almacén y la fecha son copias de su póliza (se reescriben con ella) para el kardex sin JOIN.
// La FK compuesta impide que una partida cuelgue de una póliza de otra sucursal o empresa.
model MovimientoInventario {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  sucursalId        String   @map("sucursal_id") @db.Uuid
  polizaId          String   @map("poliza_id") @db.Uuid
  renglon           Int
  almacenOrigenSrId String   @map("almacen_origen_sr_id")
  insumoOrigenSrId  String   @map("insumo_origen_sr_id")
  fecha             DateTime @db.Timestamptz(3)
  cantidad          Decimal  @db.Decimal(12, 3)
  costoUnitario     Decimal  @map("costo_unitario") @db.Decimal(12, 2)
  importe           Decimal  @db.Decimal(12, 2)

  sucursal Sucursal         @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "movimientos_inventario_sucursal_empresa_fkey")
  poliza   PolizaInventario @relation(fields: [polizaId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Cascade, map: "movimientos_inventario_poliza_fkey")

  @@unique([polizaId, renglon], map: "movimientos_inventario_poliza_renglon_key")
  @@index([empresaId])
  @@index([sucursalId, almacenOrigenSrId, insumoOrigenSrId, fecha], map: "movimientos_inventario_kardex_idx")
  // La línea de tiempo sin almacén: sucursal + rango, ordenada por fecha.
  @@index([sucursalId, fecha], map: "movimientos_inventario_linea_tiempo_idx")
  @@map("movimientos_inventario")
}

// F2-123. Estado de un conteo físico. Sólo `en_captura` admite captura; cerrar y cancelar son
// finales.
enum EstadoConteo {
  en_captura
  cerrado
  cancelado

  @@map("estado_conteo")
}

// F2-123. Un conteo físico de UN almacén (todos sus artículos o los de un grupo). Es dato
// NUESTRO: se captura en el panel y NUNCA se escribe a SoftRestaurant; el reporte de
// diferencias es lo que el encargado lleva a SR para ajustar ahí. Lo escribe SÓLO
// `EscrituraConteos` (con el scope del usuario). `teorico_capturado_at` = el corte de la foto de
// existencias (F2-121) que se congeló en sus partidas al crearlo. CHECKs a mano: folio > 0 y
// estado ⇔ sus marcas de cierre/cancelación.
model ConteoFisico {
  id                 String       @id @default(uuid()) @db.Uuid
  empresaId          String       @map("empresa_id") @db.Uuid
  sucursalId         String       @map("sucursal_id") @db.Uuid
  folio              Int
  almacenOrigenSrId  String       @map("almacen_origen_sr_id")
  // Nulo = todos los artículos del almacén.
  grupoOrigenSrId    String?      @map("grupo_origen_sr_id")
  nota               String?
  estado             EstadoConteo @default(en_captura)
  teoricoCapturadoAt DateTime     @map("teorico_capturado_at") @db.Timestamptz(3)
  creadoPor          String       @map("creado_por") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  cerradoPor         String?      @map("cerrado_por") @db.Uuid
  cerradoAt          DateTime?    @map("cerrado_at") @db.Timestamptz(3)
  canceladoPor       String?      @map("cancelado_por") @db.Uuid
  canceladoAt        DateTime?    @map("cancelado_at") @db.Timestamptz(3)
  updatedAt          DateTime     @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal        @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "conteos_fisicos_sucursal_empresa_fkey")
  partidas PartidaConteo[]

  @@unique([sucursalId, folio], map: "conteos_fisicos_sucursal_folio_key")
  @@unique([id, sucursalId, empresaId], map: "conteos_fisicos_id_sucursal_empresa_key")
  @@index([empresaId])
  @@index([sucursalId, estado])
  @@map("conteos_fisicos")
}

// F2-123. Un renglón de un conteo: UN insumo. `teorico` y `costo_promedio` son la foto de
// existencias congelada al crear el conteo (nulos los dos = el artículo no venía en la foto:
// "sin teórico", NUNCA un 0 inventado). `contado` nulo = sin contar (tampoco es 0). La FK
// compuesta impide que un renglón cuelgue de un conteo de otra sucursal o empresa. CHECKs a
// mano: contado >= 0, costo >= 0, teórico y costo nulos a la vez.
model PartidaConteo {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  sucursalId       String    @map("sucursal_id") @db.Uuid
  conteoId         String    @map("conteo_id") @db.Uuid
  insumoOrigenSrId String    @map("insumo_origen_sr_id")
  teorico          Decimal?  @db.Decimal(12, 3)
  costoPromedio    Decimal?  @map("costo_promedio") @db.Decimal(12, 2)
  contado          Decimal?  @db.Decimal(12, 3)
  capturadoPor     String?   @map("capturado_por") @db.Uuid
  capturadoAt      DateTime? @map("capturado_at") @db.Timestamptz(3)

  sucursal Sucursal     @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "partidas_conteo_sucursal_empresa_fkey")
  conteo   ConteoFisico @relation(fields: [conteoId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Cascade, map: "partidas_conteo_conteo_fkey")

  @@unique([conteoId, insumoOrigenSrId], map: "partidas_conteo_conteo_insumo_key")
  @@index([empresaId])
  @@map("partidas_conteo")
}

// F2-124. Estado del FLUJO de un traspaso del panel (independiente de su conciliación con SR):
// `enviado` (1.ª confirmación, al crearlo) → `recibido` (2.ª). Cancelar sólo desde `enviado`.
enum EstadoTraspaso {
  enviado
  recibido
  cancelado

  @@map("estado_traspaso")
}

// F2-124. Un traspaso capturado en el PANEL de un almacén a otro (de la misma sucursal o de otra
// de la misma empresa). Dato NUESTRO: nunca se escribe a SoftRestaurant. Queda "pendiente de
// registrar en SR" hasta que la conciliación encuentra sus pólizas espejo (F2-122).
// `sucursal_id` = ORIGEN. El destino va por FK compuesta con la MISMA empresa. Lo escribe SÓLO
// `EscrituraTraspasos`. CHECKs a mano: folio > 0, origen ≠ destino, estado ⇔ marcas,
// conciliado_at nulo si cancelado.
model Traspaso {
  id                 String         @id @default(uuid()) @db.Uuid
  empresaId          String         @map("empresa_id") @db.Uuid
  sucursalId         String         @map("sucursal_id") @db.Uuid
  folio              Int
  almacenOrigenSrId  String         @map("almacen_origen_sr_id")
  sucursalDestinoId  String         @map("sucursal_destino_id") @db.Uuid
  almacenDestinoSrId String         @map("almacen_destino_sr_id")
  nota               String?
  estado             EstadoTraspaso @default(enviado)
  enviadoPor         String         @map("enviado_por") @db.Uuid
  enviadoAt          DateTime       @map("enviado_at") @db.Timestamptz(3)
  recibidoPor        String?        @map("recibido_por") @db.Uuid
  recibidoAt         DateTime?      @map("recibido_at") @db.Timestamptz(3)
  canceladoPor       String?        @map("cancelado_por") @db.Uuid
  canceladoAt        DateTime?      @map("cancelado_at") @db.Timestamptz(3)
  // Nulo = no conciliado (le falta algún espejo). Se conserva mientras siga conciliado.
  conciliadoAt       DateTime?      @map("conciliado_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @map("updated_at") @db.Timestamptz(3)

  sucursal        Sucursal          @relation("TraspasoOrigen", fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "traspasos_sucursal_empresa_fkey")
  sucursalDestino Sucursal          @relation("TraspasoDestino", fields: [sucursalDestinoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "traspasos_sucursal_destino_empresa_fkey")
  partidas        PartidaTraspaso[]

  @@unique([empresaId, folio], map: "traspasos_empresa_folio_key")
  @@unique([id, sucursalId, sucursalDestinoId, empresaId], map: "traspasos_id_sucursales_empresa_key")
  @@index([sucursalId, estado])
  @@index([sucursalDestinoId])
  @@map("traspasos")
}

// F2-124. Un renglón de un traspaso: UN insumo y su cantidad (> 0). `costo_unitario` = costo
// promedio de la foto del almacén ORIGEN al enviar (nulo = sin lectura, nunca 0). El espejo en SR
// se guarda como (póliza, renglón), que sobreviven a una corrección de la póliza en la ingesta (los
// ids de `movimientos_inventario` no). Las FK compuestas atan la póliza de salida a la sucursal
// ORIGEN y la de entrada a la DESTINO, las dos de la MISMA empresa; los únicos impiden que una
// partida de SR concilie dos renglones. CHECKs a mano: cantidad > 0, póliza ⇔ renglón.
model PartidaTraspaso {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  sucursalId        String   @map("sucursal_id") @db.Uuid
  sucursalDestinoId String   @map("sucursal_destino_id") @db.Uuid
  traspasoId        String   @map("traspaso_id") @db.Uuid
  insumoOrigenSrId  String   @map("insumo_origen_sr_id")
  cantidad          Decimal  @db.Decimal(12, 3)
  costoUnitario     Decimal? @map("costo_unitario") @db.Decimal(12, 2)
  polizaSalidaId    String?  @map("poliza_salida_id") @db.Uuid
  renglonSalida     Int?     @map("renglon_salida")
  polizaEntradaId   String?  @map("poliza_entrada_id") @db.Uuid
  renglonEntrada    Int?     @map("renglon_entrada")

  sucursal        Sucursal          @relation("PartidaTraspasoOrigen", fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "partidas_traspaso_sucursal_empresa_fkey")
  sucursalDestino Sucursal          @relation("PartidaTraspasoDestino", fields: [sucursalDestinoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "partidas_traspaso_sucursal_destino_empresa_fkey")
  traspaso        Traspaso          @relation(fields: [traspasoId, sucursalId, sucursalDestinoId, empresaId], references: [id, sucursalId, sucursalDestinoId, empresaId], onDelete: Cascade, map: "partidas_traspaso_traspaso_fkey")
  polizaSalida    PolizaInventario? @relation("EspejoSalida", fields: [polizaSalidaId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Restrict, map: "partidas_traspaso_poliza_salida_fkey")
  polizaEntrada   PolizaInventario? @relation("EspejoEntrada", fields: [polizaEntradaId, sucursalDestinoId, empresaId], references: [id, sucursalId, empresaId], onDelete: Restrict, map: "partidas_traspaso_poliza_entrada_fkey")

  @@unique([traspasoId, insumoOrigenSrId], map: "partidas_traspaso_traspaso_insumo_key")
  @@unique([polizaSalidaId, renglonSalida], map: "partidas_traspaso_espejo_salida_key")
  @@unique([polizaEntradaId, renglonEntrada], map: "partidas_traspaso_espejo_entrada_key")
  @@index([empresaId])
  @@map("partidas_traspaso")
}

// F2-125. La receta de UN producto leída de SR (la cabecera): cuánto de cada insumo consume UNA
// unidad vendida. La escribe SÓLO `IngestaRecetas` (clavada a la sucursal del agente), upsert por
// (sucursal, producto_origen_sr_id). `hash` = sha256 de su forma canónica (producto + renglones
// ORDENADOS): igual = no se toca. `leida_at` (reloj del agente) decide qué versión es más nueva.
// `renglones = 0` = SR dice que el producto no tiene receta (se muestra "sin receta").
// DECISION PROVISIONAL (nocturno): una receta que deja de llegar NO se borra (el lector la manda
// vacía); producto e insumo por su `origen_sr_id` en texto, sin FK (llegan en cualquier orden).
// esquema-sr.md §10 "Recetas".
model Receta {
  id                 String   @id @default(uuid()) @db.Uuid
  empresaId          String   @map("empresa_id") @db.Uuid
  sucursalId         String   @map("sucursal_id") @db.Uuid
  productoOrigenSrId String   @map("producto_origen_sr_id")
  renglones          Int
  hash               String   @db.Char(64)
  leidaAt            DateTime @map("leida_at") @db.Timestamptz(3)
  recibidaAt         DateTime @map("recibida_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal        @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "recetas_sucursal_empresa_fkey")
  detalle  RenglonReceta[]

  @@unique([sucursalId, productoOrigenSrId], map: "recetas_sucursal_producto_key")
  @@unique([id, sucursalId, empresaId], map: "recetas_id_sucursal_empresa_key")
  @@index([empresaId])
  @@map("recetas")
}

// F2-125. Un renglón de receta: `cantidad` del insumo (en SU unidad) por UNA unidad vendida del
// producto. DECISION PROVISIONAL (nocturno): NUMERIC(12,4); más decimales se rechazan. La FK
// compuesta impide colgarlo de una receta de otra sucursal o empresa.
model RenglonReceta {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @map("empresa_id") @db.Uuid
  sucursalId       String  @map("sucursal_id") @db.Uuid
  recetaId         String  @map("receta_id") @db.Uuid
  renglon          Int
  insumoOrigenSrId String  @map("insumo_origen_sr_id")
  cantidad         Decimal @db.Decimal(12, 4)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "renglones_receta_sucursal_empresa_fkey")
  receta   Receta   @relation(fields: [recetaId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Cascade, map: "renglones_receta_receta_fkey")

  @@unique([recetaId, renglon], map: "renglones_receta_receta_renglon_key")
  @@index([empresaId])
  @@map("renglones_receta")
}

// F2-126. Una compra (documento de compra a proveedor) leída de SR. La escribe SÓLO
// `IngestaCompras` (clavada a la sucursal del agente), upsert por (sucursal, origen_sr_id), con
// las mismas reglas que las pólizas de F2-122: `hash` de la forma canónica, `leida_at` decide la
// versión, una compra nunca se borra (se reenvía `cancelada`). `total` = Σ importes de sus
// partidas, SIN IVA, lo calcula el API. Proveedor, almacén e insumo por `origen_sr_id` en texto,
// sin FK. DECISION PROVISIONAL (nocturno): la compra es un documento APARTE de su póliza de entrada
// (F2-122); el panel no las concilia ni la suma a la utilidad. esquema-sr.md §10 "Compras, gastos y utilidad".
model Compra {
  id                  String   @id @default(uuid()) @db.Uuid
  empresaId           String   @map("empresa_id") @db.Uuid
  sucursalId          String   @map("sucursal_id") @db.Uuid
  origenSrId          String   @map("origen_sr_id")
  folio               String
  proveedorOrigenSrId String?  @map("proveedor_origen_sr_id")
  almacenOrigenSrId   String?  @map("almacen_origen_sr_id")
  fecha               DateTime @db.Timestamptz(3)
  cancelada           Boolean
  total               Decimal  @db.Decimal(12, 2)
  partidas            Int
  hash                String   @db.Char(64)
  leidaAt             DateTime @map("leida_at") @db.Timestamptz(3)
  recibidaAt          DateTime @map("recibida_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal        @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "compras_sucursal_empresa_fkey")
  detalle  PartidaCompra[]

  @@unique([sucursalId, origenSrId], map: "compras_sucursal_origen_key")
  @@unique([id, sucursalId, empresaId], map: "compras_id_sucursal_empresa_key")
  @@index([empresaId])
  @@index([sucursalId, fecha])
  @@map("compras")
}

// F2-126. Una partida de compra: UN insumo, cantidad > 0 (en la unidad del insumo), costo por
// unidad SIN IVA e importe = round(cantidad × costo, 2) calculado por el API. La FK compuesta
// impide colgarla de una compra de otra sucursal o empresa.
model PartidaCompra {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @map("empresa_id") @db.Uuid
  sucursalId       String  @map("sucursal_id") @db.Uuid
  compraId         String  @map("compra_id") @db.Uuid
  renglon          Int
  insumoOrigenSrId String  @map("insumo_origen_sr_id")
  cantidad         Decimal @db.Decimal(12, 3)
  costoUnitario    Decimal @map("costo_unitario") @db.Decimal(12, 2)
  importe          Decimal @db.Decimal(12, 2)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "partidas_compra_sucursal_empresa_fkey")
  compra   Compra   @relation(fields: [compraId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Cascade, map: "partidas_compra_compra_fkey")

  @@unique([compraId, renglon], map: "partidas_compra_compra_renglon_key")
  @@index([empresaId])
  @@map("partidas_compra")
}

// F2-126. Categoría de gasto de una empresa: dato NUESTRO, nunca se escribe a SR. `nombre_clave`
// = el nombre en minúsculas y con los espacios colapsados (lo calcula el API): "Luz" y " luz " son
// la misma categoría. Inactiva = no admite gastos nuevos, los viejos se siguen mostrando.
model CategoriaGasto {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  nombre      String
  nombreClave String   @map("nombre_clave")
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "categorias_gasto_empresa_fkey")
  gastos  Gasto[]

  @@unique([empresaId, nombreClave], map: "categorias_gasto_empresa_nombre_key")
  @@unique([id, empresaId], map: "categorias_gasto_id_empresa_key")
  @@index([empresaId])
  @@map("categorias_gasto")
}

// F2-126. Un gasto de operación de una sucursal, capturado en el panel: dato NUESTRO, nunca se
// escribe a SR. `dia` es el día CONTABLE local de la sucursal (DATE, no un instante: un recibo de
// luz es de un día, no de una hora). `monto` > 0 SIN IVA acreditable (DECISION PROVISIONAL
// (nocturno), la vista lo dice). Nunca se borra: se anula (`anulado_at`), y anulado no suma.
// `folio` opcional, único por sucursal: lo usa el seed para ser idempotente.
model Gasto {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  sucursalId     String    @map("sucursal_id") @db.Uuid
  categoriaId    String    @map("categoria_id") @db.Uuid
  dia            DateTime  @db.Date
  concepto       String
  monto          Decimal   @db.Decimal(12, 2)
  folio          String?
  creadoPor      String?   @map("creado_por") @db.Uuid
  creadoAt       DateTime  @map("creado_at") @db.Timestamptz(3)
  actualizadoPor String?   @map("actualizado_por") @db.Uuid
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  anuladoPor     String?   @map("anulado_por") @db.Uuid
  anuladoAt      DateTime? @map("anulado_at") @db.Timestamptz(3)

  sucursal  Sucursal       @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "gastos_sucursal_empresa_fkey")
  categoria CategoriaGasto @relation(fields: [categoriaId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "gastos_categoria_empresa_fkey")

  @@unique([sucursalId, folio], map: "gastos_sucursal_folio_key")
  @@index([empresaId])
  @@index([sucursalId, dia])
  @@map("gastos")
}

// F2-100. Los datos fiscales de una empresa: UN emisor por empresa (DECISION PROVISIONAL
// (nocturno): varias razones sociales en una empresa sería una tarea aparte). Dato NUESTRO,
// capturado en el panel; nunca se escribe a SR. Del CSD sólo se guarda METADATA (número de
// certificado, RFC, vigencia): el .cer, el .key y su contraseña NUNCA tocan esta base (van
// directo al PAC por `PuertoTimbrado.registrarCsd`). Todo `csd_*` es nulo hasta cargarlo, y se
// vacía si cambia el RFC (ese CSD era de otro RFC). `folio_actual` lo avanza la emisión (F2-104).
model PerfilFiscal {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @unique @map("empresa_id") @db.Uuid
  rfc              String
  razonSocial      String    @map("razon_social")
  regimenFiscal    String    @map("regimen_fiscal") @db.Char(3)
  cp               String    @db.Char(5)
  serie            String
  folioActual      Int       @default(0) @map("folio_actual")
  facturamaOrgId   String?   @map("facturama_org_id")
  activo           Boolean   @default(true)
  csdNoCertificado String?   @map("csd_no_certificado")
  csdRfc           String?   @map("csd_rfc")
  csdVigenteDesde  DateTime? @map("csd_vigente_desde") @db.Timestamptz(3)
  csdVigenteHasta  DateTime? @map("csd_vigente_hasta") @db.Timestamptz(3)
  csdCargadoAt     DateTime? @map("csd_cargado_at") @db.Timestamptz(3)
  csdCargadoPor    String?   @map("csd_cargado_por") @db.Uuid
  creadoPor        String?   @map("creado_por") @db.Uuid
  actualizadoPor   String?   @map("actualizado_por") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "perfiles_fiscales_empresa_fkey")
  // F2-104: los CFDI emitidos con este perfil.
  cfdis   Cfdi[]

  // Destino de la FK compuesta de `cfdis`: el perfil de un CFDI es de SU empresa.
  @@unique([id, empresaId], map: "perfiles_fiscales_id_empresa_id_key")
  @@map("perfiles_fiscales")
}

// F2-100. Cache de receptores de factura para autocompletar (lo alimentará el portal, F2-103).
// Por empresa: el mismo RFC en dos empresas son dos filas y nunca se cruzan. `rfc` va
// normalizado (trim + mayúsculas). La ficha de Clientes (F2-232) liga por ese RFC.
model ReceptorFrecuente {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  rfc           String
  razonSocial   String   @map("razon_social")
  regimenFiscal String   @map("regimen_fiscal") @db.Char(3)
  cp            String   @db.Char(5)
  usoCfdi       String   @map("uso_cfdi")
  email         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "receptores_frecuentes_empresa_fkey")

  @@unique([empresaId, rfc], map: "receptores_frecuentes_empresa_rfc_key")
  @@map("receptores_frecuentes")
}

// ---------------------------------------------------------------------------
// F2-101 · Código corto de facturación por cheque. Dato NUESTRO: nunca se escribe a SR.
// ---------------------------------------------------------------------------

/**
 * Estado GUARDADO del código. `expirado` también se DERIVA al leer (`expira_at` ya pasó), sin
 * job; y "cancelado" no se guarda: sale del cheque (`facturacion/codigo.ts#estadoPublico`).
 */
enum EstadoCodigoFacturacion {
  pendiente
  facturado
  en_global
  expirado
}

/// Cómo se calcula la expiración de un código nuevo, por empresa.
enum ReglaVigenciaCodigo {
  /// Hasta el fin del mes de emisión en la zona de la sucursal (regla típica del SAT). Default.
  fin_de_mes
  /// Hasta el final del día N (natural) después del día de emisión, en la zona de la sucursal.
  dias
}

model CodigoFacturacion {
  id         String                  @id @default(uuid()) @db.Uuid
  // 9 caracteres de A–Z y 2–9 sin O, 0, I, 1. CHECK de formato a mano en la migración
  // `..._codigo_facturacion`. Único GLOBAL: el endpoint público busca sin tenant.
  codigo     String
  chequeId   String                  @map("cheque_id") @db.Uuid
  sucursalId String                  @map("sucursal_id") @db.Uuid
  empresaId  String                  @map("empresa_id") @db.Uuid
  estado     EstadoCodigoFacturacion @default(pendiente)
  // Se fija al generar el código y NO se recalcula (ni si cambia la regla, ni si el cheque cambia).
  expiraAt   DateTime                @map("expira_at") @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @map("updated_at") @db.Timestamptz(3)

  cheque   Cheque            @relation(fields: [chequeId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "codigos_facturacion_cheque_empresa_fkey")
  sucursal Sucursal          @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "codigos_facturacion_sucursal_empresa_fkey")
  // F2-104: el CFDI del código (o su reserva mientras se timbra). Uno como mucho: es el candado.
  cfdi     Cfdi?
  // F2-108: la factura global en la que entró el ticket (o su reserva). Una como mucho.
  global   CfdiGlobalCodigo?

  @@unique([codigo], map: "codigos_facturacion_codigo_key")
  // Destino de la FK compuesta de `cfdis`: el código de un CFDI es de SU empresa.
  @@unique([id, empresaId], map: "codigos_facturacion_id_empresa_id_key")
  // Destino de la FK de `cfdi_global_codigos` (F2-108): el ticket de una global es de SU sucursal.
  @@unique([id, sucursalId, empresaId], map: "codigos_facturacion_id_sucursal_id_empresa_id_key")
  // Un código por cheque. Con la empresa porque Prisma pide la llave completa de la FK en una
  // relación 1-1; `cheques.id` ya es único, así que equivale a único por `cheque_id`.
  @@unique([chequeId, empresaId], map: "codigos_facturacion_cheque_id_empresa_id_key")
  @@index([empresaId])
  @@index([sucursalId])
  @@map("codigos_facturacion")
}

model ConfiguracionFacturacion {
  id                    String              @id @default(uuid()) @db.Uuid
  empresaId             String              @unique @map("empresa_id") @db.Uuid
  vigenciaCodigos       ReglaVigenciaCodigo @default(fin_de_mes) @map("vigencia_codigos")
  // Sólo con `dias` (1..366). CHECK a mano en la migración `..._codigo_facturacion`.
  vigenciaDias          Int?                @map("vigencia_dias")
  // F2-108: la factura global de la empresa. Periodo (default mensual) y si se emite sola.
  globalPeriodicidad    PeriodicidadGlobal  @default(mensual) @map("global_periodicidad")
  globalAutomatica      Boolean             @default(false) @map("global_automatica")
  // Cuándo se encendió la emisión automática: sólo emite periodos que terminan DESPUÉS (CHECK a
  // mano: automática ⇔ con fecha).
  globalAutomaticaDesde DateTime?           @map("global_automatica_desde") @db.Timestamptz(3)
  actualizadoPor        String?             @map("actualizado_por") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "configuraciones_facturacion_empresa_fkey")

  @@map("configuraciones_facturacion")
}

// ---------------------------------------------------------------------------
// F2-103 · Portal público de autofactura. Dato NUESTRO: nunca se escribe a SR.
// ---------------------------------------------------------------------------

/**
 * El portal `/f/:slug` de una sucursal: su enlace público y su marca (color y logo). Uno por
 * sucursal. CHECKs a mano en la migración `..._portal_facturacion`: formato y largo del slug,
 * color `#rrggbb` en minúsculas, tipo y tamaño del logo (PNG/JPEG/WebP, <= 200 KB) y logo con su
 * tipo o ninguno de los dos.
 */
model PortalFacturacion {
  sucursalId     String   @id @map("sucursal_id") @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  // Único GLOBAL: la ruta pública busca sin tenant.
  slug           String
  color          String   @db.Char(7)
  logo           Bytes?
  logoTipo       String?  @map("logo_tipo")
  activo         Boolean  @default(true)
  // Null = lo sembró el seed (nadie lo ha editado): el seed puede reponerlo.
  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "portales_facturacion_sucursal_empresa_fkey")

  @@unique([slug], map: "portales_facturacion_slug_key")
  // Prisma pide la llave completa de la FK en una relación 1-1; `sucursal_id` ya es la PK.
  @@unique([sucursalId, empresaId], map: "portales_facturacion_sucursal_id_empresa_id_key")
  @@index([empresaId])
  @@map("portales_facturacion")
}

// ---------------------------------------------------------------------------
// F2-104 · CFDI emitidos. Dato NUESTRO: nada de esto se escribe a SoftRestaurant.
// ---------------------------------------------------------------------------

/// `timbrando` = RESERVA: la fila nace ANTES de llamar al PAC y es el candado del código.
/// F2-108: cada cuánto se emite la factura global (c_Periodicidad 01, 02 y 04).
enum PeriodicidadGlobal {
  diaria
  semanal
  mensual

  @@map("periodicidad_global")
}

enum EstadoEmisionCfdi {
  timbrando
  vigente
  cancelado

  @@map("estado_emision_cfdi")
}

enum OrigenCfdi {
  // Emitido desde un cheque (portal de autofactura, F2-104).
  ticket
  // Captura manual del administrador, sin cheque (F2-107).
  manual
  // Factura global a público en general de los tickets que nadie facturó (F2-108).
  global

  @@map("origen_cfdi")
}

model Cfdi {
  id                 String            @id @default(uuid()) @db.Uuid
  empresaId          String            @map("empresa_id") @db.Uuid
  sucursalId         String            @map("sucursal_id") @db.Uuid
  // Nulo sólo en una factura sin ticket (`origen = manual`, F2-107); un CHECK a mano lo cuida.
  chequeId           String?           @map("cheque_id") @db.Uuid
  // El candado por código (doble clic no emite dos veces): ÚNICO. Nulo = CFDI sin código
  // (F2-107, factura sin ticket); en Postgres los nulos no chocan entre sí.
  codigoId           String?           @map("codigo_id") @db.Uuid
  perfilFiscalId     String            @map("perfil_fiscal_id") @db.Uuid
  serie              String
  folio              Int
  // Nulos mientras `timbrando`; un CHECK a mano los exige en cuanto deja de serlo.
  uuid               String?
  idPac              String?           @map("id_pac")
  // { rfc, razonSocial, regimenFiscal, cp, usoCfdi, email } tal como se timbró.
  receptor           Json
  // c_FormaPago con que se timbró (p. ej. "01").
  formaPago          String            @map("forma_pago") @db.Char(2)
  subtotal           Decimal           @db.Decimal(12, 2)
  iva                Decimal           @db.Decimal(12, 2)
  total              Decimal           @db.Decimal(12, 2)
  estado             EstadoEmisionCfdi @default(timbrando)
  // Fecha de timbrado (UTC). Nula mientras `timbrando`.
  emitidoAt          DateTime?         @map("emitido_at") @db.Timestamptz(3)
  // CLAVES del XML y el PDF en `PuertoArchivos` (F2-105), no URLs: la URL de descarga se firma
  // al pedirla y vence. Nulas mientras no se guardaron (reserva, o el disco falló al timbrar).
  xmlClave           String?           @map("xml_clave")
  pdfClave           String?           @map("pdf_clave")
  // F2-107. `ticket` (del portal) o `manual` (factura sin ticket, sin cheque ni código).
  origen             OrigenCfdi        @default(ticket)
  // Llave de idempotencia de la captura manual (la genera el formulario): doble clic = un CFDI.
  solicitudId        String?           @map("solicitud_id") @db.Uuid
  // Refacturación (F2-107): el CFDI al que SUSTITUYE éste, con `TipoRelacion` 04. ÚNICO: un solo
  // sustituto por CFDI (el candado de dos refacturaciones a la vez).
  sustituyeAId       String?           @map("sustituye_a_id") @db.Uuid
  tipoRelacion       String?           @map("tipo_relacion") @db.Char(2)
  // c_MotivoCancelacion con que se canceló ante el PAC (F2-107 motivo 01; F2-109 el resto). Los
  // cancelados del seed de F2-106 no lo tienen.
  motivoCancelacion  String?           @map("motivo_cancelacion") @db.Char(2)
  canceladoAt        DateTime?         @map("cancelado_at") @db.Timestamptz(3)
  // F2-108, sólo en `origen = global` (CHECK a mano): c_Periodicidad ('01' diaria, '02' semanal,
  // '04' mensual), Meses ('01'..'12') y Año de `InformacionGlobal`, y el periodo que cubre en
  // instantes UTC (`hasta` exclusivo), cortado en la zona de la sucursal.
  globalPeriodicidad String?           @map("global_periodicidad") @db.Char(2)
  globalMeses        String?           @map("global_meses") @db.Char(2)
  globalAnio         Int?              @map("global_anio")
  globalDesde        DateTime?         @map("global_desde") @db.Timestamptz(3)
  globalHasta        DateTime?         @map("global_hasta") @db.Timestamptz(3)
  // F2-110b. Conciliación con el PAC: la última vez que una vuelta RECLAMÓ este CFDI (el candado
  // en base: un UPDATE condicional, sólo gana una vuelta cada `RECLAMO_MS`), y, en una reserva
  // `timbrando`, la PRIMERA búsqueda en el PAC que no la encontró (liberar exige una segunda).
  conciliacionAt     DateTime?         @map("conciliacion_at") @db.Timestamptz(3)
  busquedaVaciaAt    DateTime?         @map("conciliacion_vacia_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @map("updated_at") @db.Timestamptz(3)

  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "cfdis_empresa_fkey")
  sucursal      Sucursal           @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cfdis_sucursal_empresa_fkey")
  cheque        Cheque?            @relation(fields: [chequeId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cfdis_cheque_empresa_fkey")
  codigo        CodigoFacturacion? @relation(fields: [codigoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cfdis_codigo_empresa_fkey")
  perfil        PerfilFiscal       @relation(fields: [perfilFiscalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cfdis_perfil_empresa_fkey")
  envios        CfdiEnvio[]
  sustituye     Cfdi?              @relation("SustitucionCfdi", fields: [sustituyeAId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction, map: "cfdis_sustituye_a_empresa_fkey")
  sustituidoPor Cfdi?              @relation("SustitucionCfdi")
  // F2-108: los tickets de una factura global.
  globalCodigos CfdiGlobalCodigo[]
  // F2-109: las solicitudes de cancelación ante el SAT (historial; una abierta como mucho).
  cancelaciones CfdiCancelacion[]

  @@unique([codigoId], map: "cfdis_codigo_id_key")
  @@unique([sustituyeAId], map: "cfdis_sustituye_a_id_key")
  // Prisma pide la llave completa de la FK en una relación 1-1; equivale al único de arriba.
  @@unique([sustituyeAId, empresaId], map: "cfdis_sustituye_a_id_empresa_id_key")
  @@unique([empresaId, solicitudId], map: "cfdis_empresa_id_solicitud_id_key")
  // Prisma pide la llave completa de la FK en una relación 1-1; equivale al único de arriba.
  @@unique([codigoId, empresaId], map: "cfdis_codigo_id_empresa_id_key")
  @@unique([uuid], map: "cfdis_uuid_key")
  // Destino de la FK compuesta de `cfdi_envios` (F2-105).
  @@unique([id, empresaId], map: "cfdis_id_empresa_id_key")
  // Destino de la FK de `cfdi_global_codigos` (F2-108): la global y sus tickets, de la MISMA sucursal.
  @@unique([id, sucursalId, empresaId], map: "cfdis_id_sucursal_id_empresa_id_key")
  // Un folio por serie y empresa (los folios los reparte `perfiles_fiscales.folio_actual`).
  @@unique([empresaId, serie, folio], map: "cfdis_empresa_id_serie_folio_key")
  // Tablero de facturación (F2-106): por empresa y fecha de timbrado.
  @@index([empresaId, emitidoAt], map: "cfdis_empresa_id_emitido_at_idx")
  @@index([chequeId])
  @@index([sucursalId])
  @@map("cfdis")
}

enum EstadoEnvioCfdi {
  // Reclamado: el correo está saliendo. Uno que se queda aquí más de 10 min (proceso muerto a
  // media llamada) se puede reintentar a mano (`ENVIO_VENCIDO_MS`).
  enviando
  enviado
  // El puerto de correo falló: queda para reintento manual desde administración.
  fallido

  @@map("estado_envio_cfdi")
}

// La entrega por correo de un CFDI (F2-105): una fila por (CFDI, correo). El reintento la
// actualiza (intentos + 1). El correo sale SIEMPRE al del receptor con que se timbró; nunca a
// uno que escriba quien pide el reintento. CHECK a mano: `intentos >= 1`.
model CfdiEnvio {
  id              String          @id @default(uuid()) @db.Uuid
  empresaId       String          @map("empresa_id") @db.Uuid
  cfdiId          String          @map("cfdi_id") @db.Uuid
  email           String
  estado          EstadoEnvioCfdi @default(enviando)
  intentos        Int             @default(1)
  // Último error del puerto, recortado. Nunca lleva credenciales (el puerto no las pone).
  error           String?
  // Id del mensaje que devolvió el puerto de correo.
  correoId        String?         @map("correo_id")
  ultimoIntentoAt DateTime        @map("ultimo_intento_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "cfdi_envios_empresa_fkey")
  cfdi    Cfdi    @relation(fields: [cfdiId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cfdi_envios_cfdi_empresa_fkey")

  @@unique([cfdiId, email], map: "cfdi_envios_cfdi_id_email_key")
  @@index([empresaId, estado])
  @@map("cfdi_envios")
}

/// F2-109: en qué va una solicitud de cancelación de un CFDI ante el SAT.
enum EstadoCancelacionCfdi {
  // La llamada al PAC está saliendo, o su respuesta fue AMBIGUA (timeout, 5xx): hay que CONSULTAR
  // antes de volver a pedir nada.
  solicitando
  // El SAT espera la respuesta del receptor (acepta, rechaza, o a las 72 h procede).
  en_proceso
  aceptada
  // El receptor la rechazó: el CFDI sigue vigente y se puede volver a solicitar.
  rechazada
  // F2-110b. Una `solicitando` que a los 10 min el PAC veía VIGENTE: se dio por no registrada, pero
  // Facturama pudo registrarla TARDE. No cuenta como abierta (se puede volver a pedir); la
  // conciliación la consulta hasta 7 días y, si el PAC la ve cancelada, la acepta con sus efectos.
  sin_confirmar

  @@map("estado_cancelacion_cfdi")
}

/// F2-109: una fila por SOLICITUD de cancelación (historial). A mano en la migración: el ÚNICO
/// PARCIAL `(cfdi_id) WHERE estado IN ('solicitando','en_proceso')` (una abierta por CFDI: el candado
/// del doble clic), y los CHECK de motivo 01..04, sustituto ⇔ 01 y `resuelta_at` ⇔ aceptada/rechazada.
/// Una solicitud que el PAC rechazó sin hacer nada se BORRA (queda en la auditoría).
model CfdiCancelacion {
  id              String                @id @default(uuid()) @db.Uuid
  empresaId       String                @map("empresa_id") @db.Uuid
  cfdiId          String                @map("cfdi_id") @db.Uuid
  // c_MotivoCancelacion '01'..'04'.
  motivo          String                @db.Char(2)
  // Sólo con motivo 01: el UUID del sustituto (relación 04).
  uuidSustitucion String?               @map("uuid_sustitucion")
  estado          EstadoCancelacionCfdi @default(solicitando)
  solicitadaAt    DateTime              @map("solicitada_at") @db.Timestamptz(3)
  resueltaAt      DateTime?             @map("resuelta_at") @db.Timestamptz(3)
  // Código y mensaje recortado del último error del PAC al consultar (nunca el cuerpo crudo).
  ultimoError     String?               @map("ultimo_error")
  // Sólo al cancelar una GLOBAL: sus tickets antes de soltarlos, [{ codigoId, total }] con el
  // total como TEXTO decimal ("123.45"), nunca número JSON.
  ticketsGlobal   Json?                 @map("tickets_global")
  // El aviso por correo al receptor cuando quedó cancelada.
  avisoEnviadoAt  DateTime?             @map("aviso_enviado_at") @db.Timestamptz(3)
  avisoError      String?               @map("aviso_error")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "cfdi_cancelaciones_empresa_fkey")
  // CASCADE: un CFDI emitido nunca se borra en la app (sólo seed y fixtures); así no truenan.
  cfdi    Cfdi    @relation(fields: [cfdiId, empresaId], references: [id, empresaId], onDelete: Cascade, map: "cfdi_cancelaciones_cfdi_empresa_fkey")

  @@index([empresaId, estado])
  @@index([cfdiId])
  @@map("cfdi_cancelaciones")
}

/// F2-108: qué tickets (códigos de facturación) entraron a qué factura global. Una fila por ticket;
/// `codigo_id` ÚNICO es el candado: un ticket entra a UNA global como mucho. Las dos FK llevan
/// sucursal y empresa: un ticket de otra sucursal (o empresa) no puede colgar de la global. Borrar la
/// reserva de la global (`liberarReserva`) suelta sus tickets por CASCADE.
model CfdiGlobalCodigo {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  sucursalId String   @map("sucursal_id") @db.Uuid
  cfdiId     String   @map("cfdi_id") @db.Uuid
  codigoId   String   @map("codigo_id") @db.Uuid
  // El total del ticket tal como entró a la global (dinero: NUMERIC, nunca float).
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  empresa Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict, map: "cfdi_global_codigos_empresa_fkey")
  cfdi    Cfdi              @relation(fields: [cfdiId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Cascade, map: "cfdi_global_codigos_cfdi_fkey")
  codigo  CodigoFacturacion @relation(fields: [codigoId, sucursalId, empresaId], references: [id, sucursalId, empresaId], onDelete: Restrict, map: "cfdi_global_codigos_codigo_fkey")

  @@unique([codigoId], map: "cfdi_global_codigos_codigo_id_key")
  // Prisma pide la llave completa de la FK en una relación 1-1; equivale al único de arriba.
  @@unique([codigoId, sucursalId, empresaId], map: "cfdi_global_codigos_codigo_sucursal_empresa_key")
  @@index([empresaId])
  @@index([sucursalId])
  @@index([cfdiId])
  @@map("cfdi_global_codigos")
}

// ---------------------------------------------------------------------------
// F2-110 · Control de folios del PAC. Modelos de PLATAFORMA: no son de ninguna empresa (el saldo
// de folios es el de la cuenta de Facturama multiemisor, que compra el admin_global). Sin
// `empresa_id` ni índice por empresa: los lee SÓLO `LecturaFoliosPlataforma` y los escribe SÓLO
// `EscrituraFolios` (`src/scope/folios-plataforma.ts`), con scope global.
// ---------------------------------------------------------------------------

/// F2-143 · El canal de versiones del agente. Modelo de PLATAFORMA (como `PaqueteFolios`): el
/// binario es el mismo para todas las empresas y lo publica el admin_global. Sin `empresa_id`: lo
/// lee y escribe SÓLO `src/scope/versiones-agente.ts`. La VIGENTE es la publicada más reciente no
/// retirada. CHECKs a mano: `version` X.Y.Z, `sha256` 64 hex minúsculas, `tamano_bytes` > 0.
model VersionAgente {
  id           String    @id @default(uuid()) @db.Uuid
  version      String    @unique @db.VarChar(20)
  sha256       String    @db.Char(64)
  tamanoBytes  Int       @map("tamano_bytes")
  // Clave en `PuertoArchivos` (`agente/<version>/agente.exe`).
  claveArchivo String    @map("clave_archivo")
  notas        String?   @db.VarChar(500)
  publicadaAt  DateTime  @map("publicada_at") @db.Timestamptz(3)
  publicadaPor String?   @map("publicada_por") @db.Uuid
  retiradaAt   DateTime? @map("retirada_at") @db.Timestamptz(3)

  @@index([publicadaAt])
  @@map("versiones_agente")
}

/// Un paquete de folios comprado al PAC. Vence 12 meses después de la compra (`vence_at`, exclusivo).
/// CHECKs a mano en la migración: cantidad 1..1000000, vence_at > comprado_at.
model PaqueteFolios {
  id              String    @id @default(uuid()) @db.Uuid
  cantidad        Int
  compradoAt      DateTime  @map("comprado_at") @db.Timestamptz(3)
  venceAt         DateTime  @map("vence_at") @db.Timestamptz(3)
  nota            String?   @db.VarChar(200)
  // Cuándo se avisó por correo que vence (una vez por paquete).
  avisoVigenciaAt DateTime? @map("aviso_vigencia_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([venceAt])
  @@map("paquetes_folios")
}

/// La configuración del control de folios: UNA fila (`id = 1`, CHECK a mano), creada por la
/// migración. `control_activo` se prende con el primer paquete y ninguna ruta lo apaga.
model ConfiguracionFolios {
  id            Int       @id @db.SmallInt
  umbralPct     Int       @default(20) @map("umbral_pct")
  controlActivo Boolean   @default(false) @map("control_activo")
  // Cuándo se avisó que el saldo cruzó el umbral; se limpia cuando el saldo vuelve a estar bien.
  avisoUmbralAt DateTime? @map("aviso_umbral_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("configuracion_folios")
}
