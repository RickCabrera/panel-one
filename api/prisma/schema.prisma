// Canal de NEGOCIO de un área (F2-233). DECISION PROVISIONAL (nocturno): enum fijo con el
// conjunto de F2-144; agregar un canal ("para llevar", "eventos") es una migración. Decisión
// abierta para Ricardo (esquema-sr.md §8). El spike de F2-144 NO la cerró (sin instalación real):
// sigue abierta; qué tocar para agregar un canal, en docs/delivery.md §5.
enum CanalNegocio {
  comedor
  mostrador
  domicilio
  plataformas

  @@map("canal_negocio")
}

// El mapeo área del POS → canal de negocio (F2-233). Es NUESTRO, no del POS: vive aparte, como
// `productos_metadata`, y ninguna sincronización lo toca. Cuelga de la fila espejo del área, que
// nunca se borra (renombrar = misma fila; desaparecer = `activo=false`; reaparecer = misma fila):
// por eso sobrevive cualquier re-sync. Sin fila = "área sin canal asignado". Se aplica AL LEER:
// cambiarlo recalcula cualquier periodo sin re-ingerir nada.
model AreaCanal {
  areaId         String       @id @map("area_id") @db.Uuid
  empresaId      String       @map("empresa_id") @db.Uuid
  canal          CanalNegocio
  actualizadoPor String       @map("actualizado_por") @db.Uuid
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)

  area AreaCatalogo @relation(fields: [areaId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "areas_canal_area_empresa_fkey")

  @@unique([areaId, empresaId], map: "areas_canal_area_id_empresa_id_key")
  @@index([empresaId])
  @@map("areas_canal")
}

// Metadata PROPIA de un producto (F2-230): es nuestra, no del POS, y por eso vive
// aparte: una sincronización nunca la toca, y la fila espejo de la que cuelga
// nunca se borra. CHECKs a mano en la migración: mínimo y máximo >= 0,
// mínimo <= máximo y a lo más 20 etiquetas.
model ProductoMetadata {
  productoId     String   @id @map("producto_id") @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  descripcion    String?
  fotoUrl        String?  @map("foto_url")
  etiquetas      String[] @default([])
  // No es dinero: existencias (unidades, kg) como `cheque_partidas.cantidad`.
  minimo         Decimal? @db.Decimal(12, 3)
  maximo         Decimal? @db.Decimal(12, 3)
  actualizadoPor String   @map("actualizado_por") @db.Uuid
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  producto Producto @relation(fields: [productoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "productos_metadata_producto_empresa_fkey")

  @@unique([productoId, empresaId], map: "productos_metadata_producto_id_empresa_id_key")
  @@index([empresaId])
  @@map("productos_metadata")
}

// La última sincronización COMPLETA aplicada de cada catálogo de una sucursal
// (el último `POST /ingesta/catalogos/cierre` aceptado). `ultima_completa_at` es
// el `capturadoAt` del agente; `recibida_at`, el reloj del servidor.
model SincronizacionCatalogo {
  sucursalId       String     @map("sucursal_id") @db.Uuid
  catalogo         CatalogoSr
  empresaId        String     @map("empresa_id") @db.Uuid
  sincronizacionId String     @map("sincronizacion_id") @db.Uuid
