  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "clientes_catalogo_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "clientes_catalogo_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("clientes_catalogo")
