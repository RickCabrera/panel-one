  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "proveedores_catalogo_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "proveedores_catalogo_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  @@index([sucursalId, sincronizacionId])
