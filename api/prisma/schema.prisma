  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "insumos_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "insumos_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  @@index([sucursalId, sincronizacionId])
