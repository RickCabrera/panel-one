// Esquema núcleo del monitor (F1-010): empresas, sucursales, usuarios y el
// estado del agente de cada sucursal.
//
// Convenciones que valen para todo lo que se agregue después:
// - Campos camelCase en TypeScript, snake_case en la base (`@map`/`@@map`).
// - IDs UUID generados por Prisma.
// - Todo timestamp es `timestamptz` y se guarda en UTC. La presentación en
//   `America/Mexico_City` y los cortes de "hoy" en la zona de la sucursal son
//   cosa del código, nunca de la base.
// - Toda tabla de datos lleva `empresa_id` con índice: el helper de scope de
//   F1-011 filtra por esa columna en TODO query.
// - Las FK son `onDelete: Restrict`: nada se borra en cascada. Dar de baja es
//   `activo = false`.
//
// Hay un CHECK que Prisma no modela y que vive sólo en la migración
// `..._esquema_nucleo`: `usuarios_rol_empresa_chk`. Si alguna vez se regenera
// la migración inicial, hay que volver a ponerlo a mano.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  admin_global
  admin_empresa
  visor

  @@map("rol_usuario")
}

model Empresa {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursales           Sucursal[]
  usuarios             Usuario[]
  formasPagoCatalogo   FormaPagoCatalogo[]
  correosEnviados      CorreoEnviado[]
  alertas              Alerta[]
  reglasAlerta         ReglaAlerta[]
  alertaEvaluacion     AlertaEvaluacion?
  suscripcionesReporte SuscripcionReporte[]

  @@map("empresas")
}

model Sucursal {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  nombre      String
  // Zona IANA de la sucursal. Es la que corta "ventas de hoy", no la del servidor.
  zonaHoraria String   @default("America/Mexico_City") @map("zona_horaria")
  // Hash de la API key del agente. Nulo hasta que F1-012 la genere. Ojo F1-012:
  // tiene que ser un hash determinista (SHA-256 de una key de alta entropía)
  // para poder buscar por igualdad; argon2 lleva sal y no sirve para eso.
  apiKeyHash  String?  @unique @map("api_key_hash")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  agenteEstado   AgenteEstado?
  agenteContacto AgenteContacto?
  cheques        Cheque[]
  mesaSnapshots  MesaSnapshot[]
  alertas        Alerta[]

  // Catálogos espejo (F2-230).
  gruposProducto           GrupoProducto[]
  productos                Producto[]
  meserosCatalogo          MeseroCatalogo[]
  clientesCatalogo         ClienteCatalogo[]
  areasCatalogo            AreaCatalogo[]
  canalesVentaCatalogo     CanalVentaCatalogo[]
  sincronizacionesCatalogo SincronizacionCatalogo[]
  solicitudSincronizacion  SolicitudSincronizacion?

  // Destino de las FK compuestas (`agente_estado`, `agente_contacto`, `cheques`,
  // `mesa_snapshots`): garantiza que la empresa que guarda una tabla hija sea
  // la empresa real de la sucursal.
  @@unique([id, empresaId], map: "sucursales_id_empresa_id_key")
  @@index([empresaId])
  @@map("sucursales")
}

model Usuario {
  id            String     @id @default(uuid()) @db.Uuid
  // Siempre en minúsculas: lo normaliza quien escribe (seed, y login en F1-011).
  email         String     @unique
  passwordHash  String     @map("password_hash")
  nombre        String
  rol           RolUsuario
  // Nulo sólo para admin_global, obligatorio para los demás roles. Lo garantiza
  // el CHECK `usuarios_rol_empresa_chk` de la migración, no este schema.
  empresaId     String?    @map("empresa_id") @db.Uuid
  activo        Boolean    @default(true)
  // Versión de las sesiones del usuario (F1-060). Va en el refresh token (claim
  // `ver`) y el refresh la compara con la base: cambiar o restablecer la
  // contraseña, o desactivar al usuario, la incrementa y deja sin efecto todo
  // refresh emitido antes. El access token (15 min) NO se revoca con esto.
  versionSesion Int        @default(0) @map("version_sesion")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  // Sesiones de login (F1-093). La segunda relación es la FK compuesta que
  // impide que `sesiones_usuario.empresa_id` diverja de la del usuario.
  sesiones             SesionUsuario[]
  sesionesEmpresa      SesionUsuario[]      @relation("SesionUsuarioEmpresa")
  suscripcionesReporte SuscripcionReporte[]

  // Redundante con el PK, pero Prisma lo exige para la FK compuesta de
  // `sesiones_usuario` (usuario_id, empresa_id).
  @@unique([id, empresaId], map: "usuarios_id_empresa_id_key")
  @@index([empresaId])
  @@map("usuarios")
}

// Una fila por login (F1-093). El refresh token lleva su `id` en el claim `sid`
// y lo CONSERVA al rotar: el logout marca `revocada_en` y mueren el refresh
// vigente y todos los anteriores de esa sesión, sólo de esa. `version_sesion`
// del usuario sigue invalidando TODAS (cambio/reset de contraseña, baja).
//
// No es dato de negocio: sólo la lee y escribe `AuthService`, por `sid` y
// `usuario_id` sacados de un JWT firmado, nunca por el helper de scope.
model SesionUsuario {
  id         String    @id @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  // Denormalizado de `usuarios.empresa_id` (nulo sólo para admin_global) para
  // que LLAVE_EMPRESA (scope.helper.ts) no tenga casos especiales, como en
  // AgenteEstado. La FK compuesta impide que diverja cuando no es nulo; con
  // NULL (admin_global) no aplica (MATCH SIMPLE) y queda la simple.
  empresaId  String?   @map("empresa_id") @db.Uuid
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  // Deslizante: cada rotación del refresh la corre 7 días, como el refresh.
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz(3)

  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "sesiones_usuario_usuario_id_fkey")
  // `usuarios.empresa_id` no cambia hoy (ningún endpoint lo edita); si algún
  // día cambia, ON UPDATE CASCADE arrastra las sesiones en vez de fallar.
  usuarioEmpresa Usuario? @relation("SesionUsuarioEmpresa", fields: [usuarioId, empresaId], references: [id, empresaId], onDelete: Cascade, onUpdate: Cascade, map: "sesiones_usuario_usuario_empresa_fkey")

  @@index([usuarioId])
  @@index([empresaId])
  @@map("sesiones_usuario")
}

model AgenteEstado {
  sucursalId      String    @id @map("sucursal_id") @db.Uuid
  // DECISION PROVISIONAL (nocturno): el backlog define AgenteEstado sólo con
  // sucursal_id, pero toda tabla de datos lleva empresa_id indexado para que el
  // helper de scope no tenga casos especiales. Se denormaliza y la FK compuesta
  // (sucursal_id, empresa_id) impide que diverja de la empresa de la sucursal.
  empresaId       String    @map("empresa_id") @db.Uuid
  versionAgente   String?   @map("version_agente")
  versionSr       String?   @map("version_sr")
  ultimaLecturaAt DateTime? @map("ultima_lectura_at") @db.Timestamptz(3)
  ultimoError     String?   @map("ultimo_error")
  // Tamaño de la cola local del agente (F1-061), como lo reporta el heartbeat.
  // CHECK >= 0 escrito a mano en la migración 20260921085338_agente_contacto.
  tamanoCola      Int?      @map("tamano_cola")
  // Latencia de la consulta de SR del último ciclo, en ms (F1-025), como la
  // reporta el heartbeat. CHECK >= 0 escrito a mano en la migración
  // *_latencia_query.
  latenciaQueryMs Int?      @map("latencia_query_ms")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "agente_estado_sucursal_empresa_fkey")

  // Redundante con el PK, pero Prisma lo exige para que la relación 1:1 use
  // la FK compuesta.
  @@unique([sucursalId, empresaId], map: "agente_estado_sucursal_id_empresa_id_key")
  @@index([empresaId])
  @@map("agente_estado")
}

// Cuándo nos habló por última vez el agente de una sucursal (F1-061), con el
// reloj del SERVIDOR: lo escribe todo lote aceptado por `POST /ingesta/eventos`.
// Es metadato de conexión (como el `last_used_at` de una API key), no dato de la
// ingesta: por eso vive fuera de `agente_estado` y fuera de la foto de
// idempotencia. Un reenvío SÍ lo mueve, porque el agente sí nos habló.
model AgenteContacto {
  sucursalId       String   @id @map("sucursal_id") @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  ultimoContactoAt DateTime @map("ultimo_contacto_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "agente_contacto_sucursal_empresa_fkey")

  @@unique([sucursalId, empresaId], map: "agente_contacto_sucursal_id_empresa_id_key")
  @@index([empresaId])
  @@map("agente_contacto")
}

// ---------------------------------------------------------------------------
// Ventas (F1-030): lo que el agente lee de SoftRestaurant y manda por la
// ingesta (F1-031). Las tablas se llenan SÓLO desde la ingesta; nada de aquí
// se escribe de vuelta al POS.
//
// - Todo importe es NUMERIC(12,2) (`Decimal`), nunca float.
// - Todo timestamp es timestamptz en UTC. Los cortes de "hoy" se calculan en
//   la zona de la sucursal (F1-032), no aquí.
// - Cada tabla lleva su propio `empresa_id` indexado (helper de scope) y una FK
//   COMPUESTA hacia su padre `(padre_id, empresa_id) → padre(id, empresa_id)`:
//   la empresa de una hija no puede divergir de la de su padre. Mismo patrón
//   que `agente_estado` (F1-010).
// - Sin CHECK de signo en importes ni cantidades: ver DECISION PROVISIONAL en
//   `Cheque`.
// ---------------------------------------------------------------------------

enum FormaPago {
  efectivo
  tarjeta
  transferencia
  otro

  @@map("forma_pago")
}

model Cheque {
  id         String    @id @default(uuid()) @db.Uuid
  sucursalId String    @map("sucursal_id") @db.Uuid
  empresaId  String    @map("empresa_id") @db.Uuid
  // DECISION PROVISIONAL (nocturno): `folio` (el que ve el cliente en el
  // ticket) y `folio_sr` (la llave estable del cheque dentro de SR) se guardan
  // como texto. No se ha visto una instalación real (docs/esquema-sr.md §2):
  // texto acepta tanto un entero como un alfanumérico sin perder ceros.
  folio      String
  folioSr    String    @map("folio_sr")
  abiertoAt  DateTime  @map("abierto_at") @db.Timestamptz(3)
  // DECISION PROVISIONAL (nocturno): nulo permitido. Un cheque cancelado en SR
  // podría no tener fecha de cierre (supuesto, esquema-sr.md §2). Los
  // agregados de F1-032 filtran por `cerrado_at` y un nulo simplemente no
  // entra en ningún rango.
  cerradoAt  DateTime? @map("cerrado_at") @db.Timestamptz(3)
  mesa       String?
  mesero     String?
  // DECISION PROVISIONAL (nocturno): nulo = "SR no lo reportó", distinto de
  // cero. Con default 0 un dato ausente contaminaría "comensales totales" y el
  // promedio por comensal de F1-032 (supuesto, esquema-sr.md §2).
  comensales Int?
  // DECISION PROVISIONAL (nocturno): sin CHECK >= 0 en importes. Devoluciones
  // o ajustes del POS podrían llegar negativos (supuesto, esquema-sr.md §2);
  // un CHECK que rechace datos reales tumbaría la ingesta de ese cheque.
  subtotal   Decimal   @db.Decimal(12, 2)
  impuestos  Decimal   @db.Decimal(12, 2)
  descuentos Decimal   @db.Decimal(12, 2)
  propina    Decimal   @db.Decimal(12, 2)
  total      Decimal   @db.Decimal(12, 2)
  cancelado  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal        @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cheques_sucursal_empresa_fkey")
  partidas ChequePartida[]
  pagos    ChequePago[]

  // La llave de idempotencia de la ingesta (F1-031): upsert por aquí.
  @@unique([sucursalId, folioSr], map: "cheques_sucursal_id_folio_sr_key")
  // Destino de las FK compuestas de partidas y pagos.
  @@unique([id, empresaId], map: "cheques_id_empresa_id_key")
  // Agregados por empresa y rango de cierre (F1-032). Empieza por empresa_id,
  // así que también es el índice por empresa de esta tabla.
  @@index([empresaId, cerradoAt], map: "cheques_empresa_id_cerrado_at_idx")
  // Agregados de UNA sucursal por rango de cierre (F1-032).
  @@index([sucursalId, cerradoAt], map: "cheques_sucursal_id_cerrado_at_idx")
  @@map("cheques")
}

model ChequePartida {
  id            String  @id @default(uuid()) @db.Uuid
  chequeId      String  @map("cheque_id") @db.Uuid
  // Denormalizado para el helper de scope; la FK compuesta lo ata al cheque.
  empresaId     String  @map("empresa_id") @db.Uuid
  // Posición de la partida en el ticket (0..n), tal como llega en el lote. Las
  // UUID no ordenan, y el detalle del ticket se muestra en el orden del POS.
  orden         Int
  producto      String
  categoria     String?
  // No es dinero: NUMERIC(12,3) porque SR podría vender fraccionado (kg, litros).
  // DECISION PROVISIONAL (nocturno): supuesto, esquema-sr.md §3.
  cantidad      Decimal @db.Decimal(12, 3)
  precioUnit    Decimal @map("precio_unit") @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  // Lista de modificadores tal como la arma la ingesta (incluidos los de $0.00).
  modificadores Json    @default("[]")

  cheque Cheque @relation(fields: [chequeId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cheque_partidas_cheque_empresa_fkey")

  @@unique([chequeId, orden], map: "cheque_partidas_cheque_id_orden_key")
  @@index([empresaId])
  @@map("cheque_partidas")
}

model ChequePago {
  id        String    @id @default(uuid()) @db.Uuid
  chequeId  String    @map("cheque_id") @db.Uuid
  // Denormalizado para el helper de scope; la FK compuesta lo ata al cheque.
  empresaId String    @map("empresa_id") @db.Uuid
  forma     FormaPago
  // El nombre de la forma de pago tal como viene de SR. El ENUM `forma` se
  // deriva de aquí con el catálogo de F1-032; el crudo se guarda siempre.
  formaRaw  String    @map("forma_raw")
  monto     Decimal   @db.Decimal(12, 2)

  cheque Cheque @relation(fields: [chequeId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "cheque_pagos_cheque_empresa_fkey")

  @@index([chequeId])
  @@index([empresaId])
  @@map("cheque_pagos")
}

// Foto de las mesas abiertas de una sucursal. Se conserva el último por
// sucursal más 24 h de histórico para depurar: la purga de lo más viejo la
// hace la ingesta (F1-031) al recibir uno nuevo. El "último" es el de mayor
// `capturado_at`, y el único de abajo lo resuelve con un index scan.
model MesaSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  sucursalId  String   @map("sucursal_id") @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  capturadoAt DateTime @map("capturado_at") @db.Timestamptz(3)
  payload     Json
  recibidoAt  DateTime @default(now()) @map("recibido_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "mesa_snapshots_sucursal_empresa_fkey")

  // Reenviar el mismo snapshot no lo duplica.
  @@unique([sucursalId, capturadoAt], map: "mesa_snapshots_sucursal_id_capturado_at_key")
  @@index([empresaId])
  @@map("mesa_snapshots")
}

// Catálogo de formas de pago (F1-032): traduce el texto crudo que SR guarda en
// `cheque_pagos.forma_raw` a nuestro ENUM. Los agregados lo aplican AL LEER,
// así que corregir el catálogo reclasifica el histórico sin reingerir nada.
// Un `forma_raw` sin entrada aquí cuenta como `otro` y se reporta aparte.
//
// DECISION PROVISIONAL (nocturno): un catálogo por EMPRESA (no por sucursal) y
// match EXACTO del texto, sin normalizar mayúsculas ni espacios: normalizar es
// adivinar (docs/esquema-sr.md §4). Sin CRUD todavía: F1-060 no lo incluyó (su texto
// en el backlog no lo pide) y queda como decisión abierta para Ricardo.
model FormaPagoCatalogo {
  id        String    @id @default(uuid()) @db.Uuid
  empresaId String    @map("empresa_id") @db.Uuid
  formaRaw  String    @map("forma_raw")
  forma     FormaPago
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  // Empieza por empresa_id: también es el índice por empresa de esta tabla.
  @@unique([empresaId, formaRaw], map: "formas_pago_catalogo_empresa_id_forma_raw_key")
  @@map("formas_pago_catalogo")
}

// Bandeja del correo FALSO (F2-202, `CORREO_IMPL=falso`): cada `enviar()` deja aquí
// una fila (y un .json en disco) para que los tests y el modo demo vean qué salió.
// La implementación real (Brevo) NO escribe aquí; la tabla de reintentos de la
// entrega real es de F2-105.
//
// `empresa_id` es NULL cuando el correo no es de una empresa (p. ej. un aviso al admin
// global). Ningún endpoint expone esta tabla, y quien la lea en el futuro lo hace con
// el helper de scope por `empresa_id`, como cualquier otra. Adjuntos: sólo metadatos
// (nombre, tipo, bytes, sha256); el contenido vive en el directorio del correo falso.
model CorreoEnviado {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String?  @map("empresa_id") @db.Uuid
  destinatario String
  plantilla    String
  asunto       String
  adjuntos     Json
  enviadoAt    DateTime @map("enviado_at") @db.Timestamptz(3)

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("correos_enviados")
}

// ---------------------------------------------------------------------------
// Centro de alertas (F2-224). Todo es Postgres nuestro: nada se lee ni se escribe
// en SoftRestaurant. Lo único que escribe estas tablas es `EscrituraAlertas`
// (helper de scope), bajo un candado por empresa (`pg_advisory_xact_lock`): la
// evaluación y el cambio de una regla van en serie, también entre réplicas.
// ---------------------------------------------------------------------------

enum TipoAlerta {
  sucursal_sin_reporte
  mesa_abierta
  cuenta_sin_imprimir
  caida_venta

  @@map("tipo_alerta")
}

enum SeveridadAlerta {
  critica
  advertencia

  @@map("severidad_alerta")
}

enum MotivoCierreAlerta {
  // La condición dejó de cumplirse (o el umbral nuevo ya no la alcanza).
  condicion
  regla_apagada
  sucursal_inactiva
  empresa_inactiva

  @@map("motivo_cierre_alerta")
}

// Una fila por alerta: abre cuando la condición empieza y se CIERRA (no se borra ni
// se duplica) cuando deja de cumplirse. El historial conserva las dos marcas.
//
// Unicidad de la abierta: `llave_abierta` vale `llave` mientras la alerta está
// abierta y NULL al cerrarla. Con el único (sucursal, tipo, llave_abierta), la misma
// condición nunca tiene dos filas abiertas (Postgres trata los NULL como distintos:
// las cerradas no chocan). Los CHECK que atan `llave_abierta`, `cerrada_at` y
// `motivo_cierre` viven SÓLO en la migración `..._centro_alertas` (Prisma no los
// modela).
model Alerta {
  id           String              @id @default(uuid()) @db.Uuid
  empresaId    String              @map("empresa_id") @db.Uuid
  sucursalId   String              @map("sucursal_id") @db.Uuid
  tipo         TipoAlerta
  severidad    SeveridadAlerta
  // El sujeto dentro de la sucursal: '' (sin reporte), el folio de la cuenta (mesa
  // abierta, sin imprimir) o el día local AAAA-MM-DD (caída de venta).
  llave        String
  llaveAbierta String?             @map("llave_abierta")
  // El umbral de la regla CUANDO abrió: la regla que la produjo, aunque luego cambie.
  umbral       Int
  // Lo que se vio al abrir. Sin floats: los importes van como texto decimal.
  detalle      Json
  abiertaAt    DateTime            @map("abierta_at") @db.Timestamptz(3)
  cerradaAt    DateTime?           @map("cerrada_at") @db.Timestamptz(3)
  motivoCierre MotivoCierreAlerta? @map("motivo_cierre")

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "alertas_sucursal_empresa_fkey")

  @@unique([sucursalId, tipo, llaveAbierta], map: "alertas_abierta_unica")
  @@index([empresaId, cerradaAt])
  @@index([empresaId, abiertaAt])
  @@map("alertas")
}

// Configuración de cada regla por empresa. Sin fila = la regla por defecto
// (`src/alertas/reglas.ts`). CHECK `umbral > 0` a mano en la migración.
model ReglaAlerta {
  id        String     @id @default(uuid()) @db.Uuid
  empresaId String     @map("empresa_id") @db.Uuid
  tipo      TipoAlerta
  activa    Boolean
  umbral    Int
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  // Empieza por empresa_id: también es el índice por empresa de esta tabla.
  @@unique([empresaId, tipo], map: "reglas_alerta_empresa_id_tipo_key")
  @@map("reglas_alerta")
}

// Marca de agua de la evaluación de alertas por empresa (F2-224): el instante de la última
// observación APLICADA. Se lee y se avanza bajo el candado de la empresa. Una observación
// tomada fuera del candado con un instante anterior a la marca llegó tarde (otra más nueva ya
// se aplicó) y se descarta: aplicarla cerraría con una hora anterior a la apertura o abriría
// una fila fantasma.
model AlertaEvaluacion {
  empresaId   String   @id @map("empresa_id") @db.Uuid
  observadoAt DateTime @map("observado_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("alertas_evaluacion")
}

// ---------------------------------------------------------------------------
// Reportes programados por correo (F2-141). Postgres propio: nada se lee ni se
// escribe en SoftRestaurant. Las escrituras van por `EscrituraReportes` (helper
// de scope); la baja pública, por `para(sistema).suscripcionReporte.updateMany`
// DESPUÉS de verificar el token firmado.
// ---------------------------------------------------------------------------

enum TipoReporte {
  diario
  semanal

  @@map("tipo_reporte")
}

enum EstadoEnvioReporte {
  // Reclamado por una vuelta del programador; el correo está saliendo. Uno que se
  // queda aquí (proceso muerto a media llamada) NO se reintenta: preferimos perder
  // un correo a mandarlo dos veces.
  enviando
  enviado
  // Falló el puerto; se reintenta en la siguiente vuelta hasta 3 intentos, el mismo día.
  fallido
  // No se reintenta nunca: el destinatario ya no puede ver la empresa, o se agotaron
  // los intentos.
  descartado

  @@map("estado_envio_reporte")
}

// Qué reportes quiere un usuario de una empresa. Una fila por (usuario, empresa):
// admin_global elige la empresa; los demás roles, sólo la suya (se verifica con el
// scope al guardar Y al enviar). FK simple a usuarios: admin_global tiene
// empresa_id NULL y la compuesta no aplicaría.
model SuscripcionReporte {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  diario    Boolean  @default(false)
  semanal   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  empresa Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  envios  EnvioReporte[]

  @@unique([usuarioId, empresaId], map: "suscripciones_reporte_usuario_id_empresa_id_key")
  // Destino de la FK compuesta de `envios_reporte`.
  @@unique([id, empresaId], map: "suscripciones_reporte_id_empresa_id_key")
  @@index([empresaId])
  @@map("suscripciones_reporte")
}

// Bitácora y candado de idempotencia de cada envío: el único (suscripción, tipo,
// periodo) hace que otra vuelta u otra réplica no manden el mismo reporte dos veces.
// CHECKs a mano en la migración `..._reportes_programados`: `intentos >= 1` y
// `periodo` con forma AAAA-MM-DD.
model EnvioReporte {
  id            String             @id @default(uuid()) @db.Uuid
  suscripcionId String             @map("suscripcion_id") @db.Uuid
  empresaId     String             @map("empresa_id") @db.Uuid
  tipo          TipoReporte
  // Diario: el día reportado. Semanal: el lunes de la semana reportada.
  periodo       String
  estado        EstadoEnvioReporte
  intentos      Int
  correoId      String?            @map("correo_id")
  error         String?
  creadoAt      DateTime           @map("creado_at") @db.Timestamptz(3)
  enviadoAt     DateTime?          @map("enviado_at") @db.Timestamptz(3)

  suscripcion SuscripcionReporte @relation(fields: [suscripcionId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "envios_reporte_suscripcion_empresa_fkey")

  @@unique([suscripcionId, tipo, periodo], map: "envios_reporte_suscripcion_id_tipo_periodo_key")
  @@index([empresaId])
  @@map("envios_reporte")
}

// ---------------------------------------------------------------------------
// Catálogos espejo (F2-230): lo que vive en SoftRestaurant (grupos, productos,
// meseros, clientes, áreas, canales), tal como lo manda el agente por
// `POST /ingesta/catalogos`. Espejo POR SUCURSAL: cada sucursal es su propia
// base del POS y un `origen_sr_id` sólo significa algo dentro de ella.
//
// - Se escriben SÓLO desde la ingesta (`IngestaCatalogos`, helper de scope). Nada
//   de aquí vuelve al POS.
// - Nunca se borra una fila: desaparecer de una sincronización completa la deja
//   `activo = false` con su último `visto_at`.
// - `updated_at` NO es `@updatedAt`: lo pone el helper sólo cuando cambia el
//   contenido (`hash`) o `activo`. Mover `visto_at` no lo toca, así que reenviar
//   el mismo lote deja el mismo `updated_at`.
// - `visto_at` es el `capturadoAt` de la página que trajo la fila (reloj del
//   AGENTE, acotado a no más de 5 min en el futuro por la ingesta).
// - `activo_pos`: el estado propio del POS (baja/suspendido) si SR lo reporta;
//   NULL = no lo reporta. Es distinto de `activo` (sigue existiendo en el POS).
// - CHECKs a mano en la migración `..._catalogos_espejo`: `origen_sr_id` y
//   `nombre` no vacíos, `hash` de 64 hex.
// ---------------------------------------------------------------------------

enum CatalogoSr {
  grupos
  productos
  meseros
  clientes
  areas
  canales

  @@map("catalogo_sr")
}

model GrupoProducto {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  activoPos        Boolean? @map("activo_pos")
  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "grupos_producto_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "grupos_producto_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("grupos_producto")
}

model Producto {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  // DECISION PROVISIONAL (nocturno): el grupo va por TEXTO (su `origen_sr_id`),
  // sin FK: el orden en que llegan los catálogos no está garantizado y un
  // producto con un grupo que aún no llegó (o que SR ya no tiene) no se rechaza.
  // La lectura resuelve el nombre por (sucursal, origen). esquema-sr.md §6.
  grupoOrigenSrId  String?  @map("grupo_origen_sr_id")
  activoPos        Boolean? @map("activo_pos")
  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal          @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "productos_sucursal_empresa_fkey")
  metadata ProductoMetadata?

  @@unique([sucursalId, origenSrId], map: "productos_sucursal_id_origen_sr_id_key")
  // Destino de la FK compuesta de `productos_metadata`.
  @@unique([id, empresaId], map: "productos_id_empresa_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("productos")
}

model MeseroCatalogo {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  activoPos        Boolean? @map("activo_pos")
  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "meseros_catalogo_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "meseros_catalogo_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("meseros_catalogo")
}

// Datos personales: nunca en logs ni en la auditoría (F2-232).
model ClienteCatalogo {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  telefono         String?
  correo           String?
  rfc              String?
  activoPos        Boolean? @map("activo_pos")
  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "clientes_catalogo_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "clientes_catalogo_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("clientes_catalogo")
}

model AreaCatalogo {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  activoPos        Boolean? @map("activo_pos")
  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "areas_catalogo_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "areas_catalogo_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("areas_catalogo")
}

// DECISION PROVISIONAL (nocturno): se supone que SR tiene algún catálogo de
// canal o tipo de servicio (comedor/mostrador/domicilio). No se ha visto
// (esquema-sr.md §8). El mapeo área → canal de NEGOCIO es nuestro y es F2-233.
model CanalVentaCatalogo {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  origenSrId       String   @map("origen_sr_id")
  clave            String?
  nombre           String
  activoPos        Boolean? @map("activo_pos")
  hash             String   @db.Char(64)
  activo           Boolean  @default(true)
  vistoAt          DateTime @map("visto_at") @db.Timestamptz(3)
  sincronizacionId String   @map("sincronizacion_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "canales_venta_catalogo_sucursal_empresa_fkey")

  @@unique([sucursalId, origenSrId], map: "canales_venta_catalogo_sucursal_id_origen_sr_id_key")
  @@index([empresaId])
  // El conteo y la baja del cierre van por (sucursal, sincronización).
  @@index([sucursalId, sincronizacionId])
  @@map("canales_venta_catalogo")
}

// Metadata PROPIA de un producto (F2-230): es nuestra, no del POS, y por eso vive
// aparte: una sincronización nunca la toca, y la fila espejo de la que cuelga
// nunca se borra. CHECKs a mano en la migración: mínimo y máximo >= 0,
// mínimo <= máximo y a lo más 20 etiquetas.
model ProductoMetadata {
  productoId     String   @id @map("producto_id") @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  descripcion    String?
  fotoUrl        String?  @map("foto_url")
  etiquetas      String[] @default([])
  // No es dinero: existencias (unidades, kg) como `cheque_partidas.cantidad`.
  minimo         Decimal? @db.Decimal(12, 3)
  maximo         Decimal? @db.Decimal(12, 3)
  actualizadoPor String   @map("actualizado_por") @db.Uuid
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  producto Producto @relation(fields: [productoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "productos_metadata_producto_empresa_fkey")

  @@unique([productoId, empresaId], map: "productos_metadata_producto_id_empresa_id_key")
  @@index([empresaId])
  @@map("productos_metadata")
}

// La última sincronización COMPLETA aplicada de cada catálogo de una sucursal
// (el último `POST /ingesta/catalogos/cierre` aceptado). `ultima_completa_at` es
// el `capturadoAt` del agente; `recibida_at`, el reloj del servidor.
model SincronizacionCatalogo {
  sucursalId       String     @map("sucursal_id") @db.Uuid
  catalogo         CatalogoSr
  empresaId        String     @map("empresa_id") @db.Uuid
  sincronizacionId String     @map("sincronizacion_id") @db.Uuid
  ultimaCompletaAt DateTime   @map("ultima_completa_at") @db.Timestamptz(3)
  total            Int
  rechazados       Int
  desactivados     Int
  recibidaAt       DateTime   @map("recibida_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "sincronizaciones_catalogo_sucursal_empresa_fkey")

  @@id([sucursalId, catalogo])
  @@index([empresaId])
  @@map("sincronizaciones_catalogo")
}

// El forzado manual (F2-230): un admin pide "sincroniza todo ya" y el agente lo
// lee en `GET /ingesta/catalogos/solicitud`. Una fila por sucursal: pedirlo otra
// vez sólo mueve `solicitada_at`.
model SolicitudSincronizacion {
  sucursalId    String   @id @map("sucursal_id") @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  solicitadaAt  DateTime @map("solicitada_at") @db.Timestamptz(3)
  solicitadaPor String   @map("solicitada_por") @db.Uuid

  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "solicitudes_sincronizacion_sucursal_empresa_fkey")

  @@unique([sucursalId, empresaId], map: "solicitudes_sincronizacion_sucursal_id_empresa_id_key")
  @@index([empresaId])
  @@map("solicitudes_sincronizacion")
}
