  sucursal Sucursal @relation(fields: [sucursalId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "sincronizaciones_catalogo_sucursal_empresa_fkey")

  @@id([sucursalId, catalogo])
  @@index([empresaId])
  @@map("sincronizaciones_catalogo")
}

// El forzado manual (F2-230): un admin pide "sincroniza todo ya" y el agente lo
// lee en `GET /ingesta/catalogos/solicitud`. Una fila por sucursal: pedirlo otra
