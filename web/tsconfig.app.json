{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // Los `*.test.tsx` entran aquí a propósito: `npm run build` corre `tsc -b`, así
  // que los tests se tipan con el mismo rigor que el resto. Los helpers de vitest
  // se importan explícitamente en cada test (no hay `globals: true`), y por eso no
  // hace falta meter `vitest/globals` en "types".
  "include": ["src"],
  // Los `*.node.test.ts` corren en Node (leen archivos, arrancan ESLint): los tipa
  // tsconfig.node.json, así los tipos de Node no se cuelan al código del navegador.
  // `src/pwa/sw.ts` corre en el service worker (lib WebWorker, que choca con DOM): lo tipa
  // tsconfig.sw.json (F2-146).
  "exclude": ["src/**/*.node.test.ts", "src/pwa/sw.ts"]
}
