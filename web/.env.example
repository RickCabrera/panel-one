# Copia a `web/.env.local` (nunca se commitea) para desarrollo local.
#
# Ojo: en Vite TODO lo que empieza por `VITE_` se empaqueta en el bundle y lo
# puede leer cualquiera que abra el panel. Aquí no va ni un secreto, nunca.

# A dónde manda el proxy de Vite las llamadas a `/api/*` (sin el prefijo `/api`).
# NO lleva `VITE_`: sólo lo lee vite.config.ts, no entra al bundle.
API_PROXY_TARGET=http://localhost:3000

# Color de acento del tema (hex `#rgb` o `#rrggbb`). Vacío o inválido = el de fábrica.
VITE_COLOR_ACENTO=
